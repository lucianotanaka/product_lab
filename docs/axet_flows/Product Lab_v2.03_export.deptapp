{"log":{"version":"1.0","timestamp":"2026-11-14T14:42:43.744+00:00"},"info":{"deptAppInfo":{"name":"Product Lab","creationDate":"2026-10-22T22:51:08.000+00:00","ownerEmailUser":"luciano.tanaka@global.ntt","tags":null},"deptAppVersionInfo":{"alias":"v2.03","descriptionMessage":"","creationDate":"2026-11-03T23:48:19.000+00:00","creationEmailUser":"luciano.tanaka@global.ntt","usedNodes":[{"id":14066,"typeName":"use-case","moduleVersion":{"moduleName":"deptapps-flows-contrib-nodes-audit","versionAlias":"2.2.5","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14128,"typeName":"credentials","moduleVersion":{"moduleName":"deptapps-flows-contrib-credentials","versionAlias":"1.0.1","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14753,"typeName":"nosql-find-one","moduleVersion":{"moduleName":"axet-flows-contrib-nodes-db-nosql","versionAlias":"1.0.2","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14754,"typeName":"nosql-persist","moduleVersion":{"moduleName":"axet-flows-contrib-nodes-db-nosql","versionAlias":"1.0.2","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14755,"typeName":"nosql-query","moduleVersion":{"moduleName":"axet-flows-contrib-nodes-db-nosql","versionAlias":"1.0.2","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14756,"typeName":"nosql-remove","moduleVersion":{"moduleName":"axet-flows-contrib-nodes-db-nosql","versionAlias":"1.0.2","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14795,"typeName":"deptapps-app-auth-okta","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14797,"typeName":"catch","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14798,"typeName":"function","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14799,"typeName":"http response","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14800,"typeName":"axetflows-app","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14801,"typeName":"axetflows-form","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14802,"typeName":"http in","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14803,"typeName":"enabler-llm","moduleVersion":{"moduleName":"deptapps-flows-contrib-nodes-enabler","versionAlias":"2.2.17","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14804,"typeName":"axetflows-view-action","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14810,"typeName":"link out","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14811,"typeName":"link in","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14813,"typeName":"switch","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14826,"typeName":"http request","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14828,"typeName":"delay","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14843,"typeName":"axetflows-rx-view-action","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.6.0 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}}],"usedSharedSubflowVersions":[]}},"flowsData":{"flows":[{"id":"d7713c7a9ce13213","type":"tab","label":"Fluxo 1","disabled":false,"info":"","env":[]},{"id":"305ef6944cb235df","type":"tab","label":"User Okta Entity","disabled":false,"info":"","env":[],"__deptAppsAssociatedEntity":"DeptappUserLoginOkta"},{"id":"d40a0ac12599fff5","type":"deptapps-app-auth-okta","configurationName":"OKTA Auto-Assistant Config","dbEngineType":"noSQL","databaseName":"deptapp-user-login-okta","userField":"userId","roleField":"roles","autoConfigured":true,"defaults":false,"defaultProject":"","defaultModel":""},{"id":"1a02e74b7630cc78","type":"function","z":"d7713c7a9ce13213","name":"Function - Montar plano API","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Montar plano API\n//\n// Responsabilidades:\n// - extrair o JSON produzido pelo Planner;\n// - validar intent e capability;\n// - preservar contexto;\n// - definir se a solicitacao exige Data API;\n// - construir apiPlan;\n// - preparar a primeira chamada;\n// - atualizar acompanhamento da execucao.\n//\n// IMPORTANTE:\n// O LLM NAO define URLs.\n// As URLs permitidas sao construidas somente neste Function.\n// ==========================================================\n\n\n// ==========================================================\n// 1. Extrair resposta do LLM\n// ==========================================================\n\nvar result = msg.payload;\n\n\nif (\n    msg.payload &&\n    msg.payload.choices &&\n    msg.payload.choices[0] &&\n    msg.payload.choices[0].message\n) {\n\n    result =\n        msg.payload\n            .choices[0]\n            .message\n            .content;\n}\n\n\n// ==========================================================\n// 2. Validar resposta do LLM\n// ==========================================================\n\nif (\n    result === undefined ||\n    result === null ||\n    result === \"\"\n) {\n\n    node.error(\n        \"LLM Planner nao retornou conteudo.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 3. Converter resposta para JSON\n// ==========================================================\n\nif (typeof result === \"string\") {\n\n    try {\n\n        result =\n            JSON.parse(result);\n\n    }\n    catch (error) {\n\n        node.error(\n            \"Resposta do LLM nao e um JSON valido: \"\n            + result,\n            msg\n        );\n\n        return null;\n    }\n}\n\n\n// ==========================================================\n// 4. Validar objeto\n// ==========================================================\n\nif (\n    !result ||\n    typeof result !== \"object\" ||\n    Array.isArray(result)\n) {\n\n    node.error(\n        \"Planner nao retornou um objeto JSON valido.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 5. Validar intent\n// ==========================================================\n\nif (result.intent !== \"product_lab\") {\n\n    node.error(\n        \"Intencao nao permitida: \"\n        + result.intent,\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 6. Capabilities permitidas\n// ==========================================================\n\nvar allowedCapabilities = [\n\n    \"product_summary\",\n\n    \"modules_overview\",\n\n    \"requirements_list\",\n\n    \"risks_analysis\",\n\n    \"backlog_analysis\",\n\n    \"backlog_item_quality_review\",\n\n    \"discovery_overview\",\n\n    \"discovery_opportunity_analysis\",\n\n    \"research_summary\",\n\n    \"research_insights\",\n\n    \"research_themes\",\n\n    \"research_pains\",\n\n    \"research_needs\",\n\n    \"research_opportunities\",\n\n    \"research_divergences\",\n\n    \"research_compare_stakeholders\",\n\n    \"research_evidence_analysis\",\n\n    \"value_canvas_analysis\",\n\n    \"process_mapping_analysis\",\n\n    \"prioritization_analysis\",\n\n    \"sprint_analysis\",\n\n    \"stakeholders_analysis\",\n\n    \"meetings_analysis\",\n\n    \"transcript_analysis\",\n\n    \"clarification\"\n];\n\n\nvar capability =\n    result.capability\n        ? String(result.capability).trim()\n        : null;\n\n\nif (\n    !capability ||\n    allowedCapabilities.indexOf(capability) === -1\n) {\n\n    node.error(\n        \"Capability nao permitida: \"\n        + capability,\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 7. Tipos de analise permitidos\n// ==========================================================\n\nvar allowedAnalysisTypes = [\n\n    \"lookup\",\n\n    \"summary\",\n\n    \"descriptive\",\n\n    \"insight\",\n\n    \"comparison\",\n\n    \"pattern\",\n\n    \"evidence\",\n\n    \"diagnostic\"\n];\n\n\nvar analysisType =\n    result.analysis_type\n        ? String(result.analysis_type).trim()\n        : \"lookup\";\n\n\nif (\n    allowedAnalysisTypes.indexOf(\n        analysisType\n    ) === -1\n) {\n\n    node.error(\n        \"Tipo de analise nao permitido: \"\n        + analysisType,\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 8. Obter IDs e contexto retornados pelo Planner\n// ==========================================================\n\nvar productId =\n    result.product_id !== undefined\n        ? result.product_id\n        : null;\n\n\nvar moduleName =\n    result.module || null;\n\n\nvar entityType =\n    result.entity_type || null;\n\n\nvar entityId =\n    result.entity_id !== undefined\n        ? result.entity_id\n        : null;\n\n\nvar resourceType =\n    result.resource_type || null;\n\n\nvar resourceId =\n    result.resource_id !== undefined\n        ? result.resource_id\n        : null;\n\n\nvar opportunityId =\n    result.opportunity_id !== undefined\n        ? result.opportunity_id\n        : null;\n\n\nvar researchId =\n    result.research_id !== undefined\n        ? result.research_id\n        : null;\n\n\nvar canvasId =\n    result.canvas_id !== undefined\n        ? result.canvas_id\n        : null;\n\n\nvar processId =\n    result.process_id !== undefined\n        ? result.process_id\n        : null;\n\n\nvar sprintId =\n    result.sprint_id !== undefined\n        ? result.sprint_id\n        : null;\n\n\n// ==========================================================\n// Backlog Item\n// ==========================================================\n\nvar backlogItemId =\n    result.backlog_item_id !== undefined\n        ? result.backlog_item_id\n        : null;\n\n\nvar stakeholderId =\n    result.stakeholder_id !== undefined\n        ? result.stakeholder_id\n        : null;\n\n\nvar meetingId =\n    result.meeting_id !== undefined\n        ? result.meeting_id\n        : null;\n\n\nvar transcriptId =\n    result.transcript_id !== undefined\n        ? result.transcript_id\n        : null;\n\n\n// ==========================================================\n// 9. Recuperar IDs do contexto original quando necessario\n// ==========================================================\n//\n// O contexto fornecido diretamente pelo Product Lab e mais\n// confiavel para IDs de navegacao do que uma inferencia do LLM.\n//\n// Portanto, se o Planner devolver null, utilizamos o contexto\n// original quando o valor estiver disponivel.\n// ==========================================================\n\nvar originalContext =\n    msg.productLabContext || {};\n\n\nif (\n    productId === null &&\n    originalContext.product_id !== undefined\n) {\n\n    productId =\n        originalContext.product_id;\n}\n\n\nif (\n    !moduleName &&\n    originalContext.module\n) {\n\n    moduleName =\n        originalContext.module;\n}\n\n\nif (\n    !entityType &&\n    originalContext.entity_type\n) {\n\n    entityType =\n        originalContext.entity_type;\n}\n\n\nif (\n    entityId === null &&\n    originalContext.entity_id !== undefined\n) {\n\n    entityId =\n        originalContext.entity_id;\n}\n\n\nif (\n    !resourceType &&\n    originalContext.resource_type\n) {\n\n    resourceType =\n        originalContext.resource_type;\n}\n\n\nif (\n    resourceId === null &&\n    originalContext.resource_id !== undefined\n) {\n\n    resourceId =\n        originalContext.resource_id;\n}\n\n\nif (\n    opportunityId === null &&\n    originalContext.opportunity_id !== undefined\n) {\n\n    opportunityId =\n        originalContext.opportunity_id;\n}\n\n\nif (\n    researchId === null &&\n    originalContext.research_id !== undefined\n) {\n\n    researchId =\n        originalContext.research_id;\n}\n\n\nif (\n    canvasId === null &&\n    originalContext.canvas_id !== undefined\n) {\n\n    canvasId =\n        originalContext.canvas_id;\n}\n\n\nif (\n    processId === null &&\n    originalContext.process_id !== undefined\n) {\n\n    processId =\n        originalContext.process_id;\n}\n\n\nif (\n    sprintId === null &&\n    originalContext.sprint_id !== undefined\n) {\n\n    sprintId =\n        originalContext.sprint_id;\n}\n\n\n// ==========================================================\n// Recuperar backlog_item_id do contexto\n// ==========================================================\n\nif (\n    backlogItemId === null &&\n    originalContext.backlog_item_id !== undefined\n) {\n\n    backlogItemId =\n        originalContext.backlog_item_id;\n}\n\n\nif (\n    stakeholderId === null &&\n    originalContext.stakeholder_id !== undefined\n) {\n\n    stakeholderId =\n        originalContext.stakeholder_id;\n}\n\n\nif (\n    meetingId === null &&\n    originalContext.meeting_id !== undefined\n) {\n\n    meetingId =\n        originalContext.meeting_id;\n}\n\n\nif (\n    transcriptId === null &&\n    originalContext.transcript_id !== undefined\n) {\n\n    transcriptId =\n        originalContext.transcript_id;\n}\n\n\n// ==========================================================\n// 10. Normalizar backlog_item_id\n// ==========================================================\n\nif (\n    backlogItemId !== null &&\n    backlogItemId !== \"\"\n) {\n\n    var parsedBacklogItemId =\n        Number(backlogItemId);\n\n\n    if (\n        Number.isInteger(parsedBacklogItemId) &&\n        parsedBacklogItemId > 0\n    ) {\n\n        backlogItemId =\n            parsedBacklogItemId;\n\n    }\n    else {\n\n        backlogItemId =\n            null;\n    }\n}\n\n\n// ==========================================================\n// 11. Normalizar limit\n// ==========================================================\n\nvar requestedLimit =\n    parseInt(\n        result.limit !== undefined\n            ? result.limit\n            : 10\n    );\n\n\nif (\n    isNaN(requestedLimit) ||\n    requestedLimit < 1\n) {\n\n    requestedLimit = 10;\n}\n\n\nif (requestedLimit > 200) {\n\n    requestedLimit = 200;\n}\n\n\n// ==========================================================\n// 12. Preservar contexto analitico\n// ==========================================================\n\nmsg.intent =\n    \"product_lab\";\n\n\nmsg.capability =\n    capability;\n\n\nmsg.analysisType =\n    analysisType;\n\n\nmsg.productId =\n    productId;\n\n\nmsg.module =\n    moduleName;\n\n\nmsg.entityType =\n    entityType;\n\n\nmsg.entityId =\n    entityId;\n\n\nmsg.resourceType =\n    resourceType;\n\n\nmsg.resourceId =\n    resourceId;\n\n\nmsg.opportunityId =\n    opportunityId;\n\n\nmsg.researchId =\n    researchId;\n\n\nmsg.canvasId =\n    canvasId;\n\n\nmsg.processId =\n    processId;\n\n\nmsg.sprintId =\n    sprintId;\n\n\nmsg.backlogItemId =\n    backlogItemId;\n\n\nmsg.stakeholderId =\n    stakeholderId;\n\n\nmsg.meetingId =\n    meetingId;\n\n\nmsg.transcriptId =\n    transcriptId;\n\n\nmsg.requestedLimit =\n    requestedLimit;\n\n\nmsg.needsClarification =\n    result.needs_clarification === true;\n\n\nmsg.clarificationQuestion =\n    result.clarification_question || null;\n\n\n// ==========================================================\n// 13. Configuracao da API do Product Lab\n// ==========================================================\n//\n// O aXet Flows executa dentro de container Docker.\n//\n// host.containers.internal e o hostname disponibilizado\n// pelo ambiente do aXet para acessar servicos executados\n// no host Windows.\n//\n// A API local do Product Lab utiliza a porta 8000.\n// ==========================================================\n\nvar API_BASE_URL =\n    \"http://host.containers.internal:8000\";\n\n\nmsg.productLabApiBaseUrl =\n    API_BASE_URL;\n\n\n// ==========================================================\n// 14. Inicializar plano\n// ==========================================================\n\nvar apiPlan = [];\n\n\n// ==========================================================\n// 15. Clarification\n// ==========================================================\n//\n// Clarification nao consulta a Data API.\n// ==========================================================\n\nif (\n    capability === \"clarification\" ||\n    msg.needsClarification === true\n) {\n\n    msg.capability =\n        \"clarification\";\n\n\n    msg.needsClarification =\n        true;\n\n\n    msg.skipApi =\n        true;\n\n\n    msg.apiPlan =\n        [];\n\n\n    msg.apiPlanIndex =\n        0;\n\n\n    msg.apiResults =\n        {};\n\n\n    msg.apiPlanComplete =\n        true;\n\n\n    // ======================================================\n    // ACOMPANHAMENTO DA EXECUCAO\n    // Plano concluido sem necessidade de Data API.\n    // ======================================================\n\n    if (msg.requestId) {\n\n        var clarificationExecutionKey =\n            msg.executionKey ||\n            (\n                \"agent_execution_\"\n                + msg.requestId\n            );\n\n\n        var clarificationExecution =\n            flow.get(\n                clarificationExecutionKey\n            );\n\n\n        if (clarificationExecution) {\n\n            clarificationExecution.status =\n                \"running\";\n\n            clarificationExecution.stage =\n                \"analysis\";\n\n            clarificationExecution.message =\n                \"Analisando informacoes\";\n\n            clarificationExecution.updated_at =\n                Date.now();\n\n\n            if (!clarificationExecution.steps) {\n\n                clarificationExecution.steps =\n                    {};\n            }\n\n\n            if (!clarificationExecution.steps.plan) {\n\n                clarificationExecution.steps.plan =\n                    {};\n            }\n\n\n            clarificationExecution.steps.plan.status =\n                \"completed\";\n\n            clarificationExecution.steps.plan.message =\n                \"Plano definido\";\n\n\n            if (!clarificationExecution.steps.data) {\n\n                clarificationExecution.steps.data =\n                    {};\n            }\n\n\n            clarificationExecution.steps.data.status =\n                \"not_applicable\";\n\n            clarificationExecution.steps.data.message =\n                \"Consulta de dados nao necessaria\";\n\n\n            if (!clarificationExecution.steps.analysis) {\n\n                clarificationExecution.steps.analysis =\n                    {};\n            }\n\n\n            clarificationExecution.steps.analysis.status =\n                \"running\";\n\n            clarificationExecution.steps.analysis.message =\n                \"Analisando informacoes\";\n\n\n            clarificationExecution.api_total =\n                0;\n\n            clarificationExecution.api_completed =\n                0;\n\n\n            flow.set(\n                clarificationExecutionKey,\n                clarificationExecution\n            );\n        }\n    }\n\n\n    node.status({\n\n        fill:\n            \"blue\",\n\n        shape:\n            \"dot\",\n\n        text:\n            \"Agent: plano definido\"\n    });\n\n\n    return msg;\n}\n\n\n// ==========================================================\n// 16. Product Summary\n// ==========================================================\n\nif (capability === \"product_summary\") {\n\n    if (!productId) {\n\n        node.error(\n            \"product_summary exige product_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"product_detail\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/products/\"\n            + encodeURIComponent(productId),\n\n        purpose:\n            \"Obter dados gerais do produto.\"\n    });\n}\n\n\n// ==========================================================\n// 17. Modules Overview\n// ==========================================================\n\nelse if (capability === \"modules_overview\") {\n\n    if (!productId) {\n\n        node.error(\n            \"modules_overview exige product_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"modules_overview\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/products/\"\n            + encodeURIComponent(productId)\n            + \"/modules-overview\",\n\n        purpose:\n            \"Obter visao geral dos modulos do produto.\"\n    });\n}\n\n\n// ==========================================================\n// 18. Requirements\n// ==========================================================\n\nelse if (capability === \"requirements_list\") {\n\n    if (!productId) {\n\n        node.error(\n            \"requirements_list exige product_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"requirements\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/products/\"\n            + encodeURIComponent(productId)\n            + \"/requirements?limit=\"\n            + encodeURIComponent(requestedLimit),\n\n        purpose:\n            \"Obter requisitos do produto.\"\n    });\n}\n\n\n// ==========================================================\n// 19. Risks\n// ==========================================================\n\nelse if (capability === \"risks_analysis\") {\n\n    if (!productId) {\n\n        node.error(\n            \"risks_analysis exige product_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"risks\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/products/\"\n            + encodeURIComponent(productId)\n            + \"/risks?limit=\"\n            + encodeURIComponent(requestedLimit),\n\n        purpose:\n            \"Obter riscos do produto.\"\n    });\n}\n\n\n// ==========================================================\n// 20. Backlog\n// ==========================================================\n\nelse if (capability === \"backlog_analysis\") {\n\n    if (!productId) {\n\n        node.error(\n            \"backlog_analysis exige product_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"backlog\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/products/\"\n            + encodeURIComponent(productId)\n            + \"/backlog?limit=\"\n            + encodeURIComponent(requestedLimit),\n\n        purpose:\n            \"Obter backlog do produto.\"\n    });\n}\n\n\n// ==========================================================\n// 21. Backlog Item Quality Review\n// ==========================================================\n\nelse if (\n    capability ===\n    \"backlog_item_quality_review\"\n) {\n\n    if (!backlogItemId) {\n\n        msg.capability =\n            \"clarification\";\n\n\n        msg.needsClarification =\n            true;\n\n\n        msg.clarificationQuestion =\n            \"Qual User Story ou Enabler voce deseja avaliar?\";\n\n\n        msg.skipApi =\n            true;\n\n\n        msg.apiPlan =\n            [];\n\n\n        msg.apiPlanIndex =\n            0;\n\n\n        msg.apiResults =\n            {};\n\n\n        msg.apiPlanComplete =\n            true;\n\n\n        // ==================================================\n        // ACOMPANHAMENTO DA EXECUCAO\n        // ==================================================\n\n        if (msg.requestId) {\n\n            var backlogClarificationKey =\n                msg.executionKey ||\n                (\n                    \"agent_execution_\"\n                    + msg.requestId\n                );\n\n\n            var backlogClarificationExecution =\n                flow.get(\n                    backlogClarificationKey\n                );\n\n\n            if (backlogClarificationExecution) {\n\n                backlogClarificationExecution.status =\n                    \"running\";\n\n                backlogClarificationExecution.stage =\n                    \"analysis\";\n\n                backlogClarificationExecution.message =\n                    \"Analisando informacoes\";\n\n                backlogClarificationExecution.updated_at =\n                    Date.now();\n\n\n                if (!backlogClarificationExecution.steps) {\n\n                    backlogClarificationExecution.steps =\n                        {};\n                }\n\n\n                backlogClarificationExecution.steps.plan = {\n                    status:\n                        \"completed\",\n\n                    message:\n                        \"Plano definido\"\n                };\n\n\n                backlogClarificationExecution.steps.data = {\n                    status:\n                        \"not_applicable\",\n\n                    message:\n                        \"Consulta de dados nao necessaria\"\n                };\n\n\n                backlogClarificationExecution.steps.analysis = {\n                    status:\n                        \"running\",\n\n                    message:\n                        \"Analisando informacoes\"\n                };\n\n\n                backlogClarificationExecution.api_total =\n                    0;\n\n                backlogClarificationExecution.api_completed =\n                    0;\n\n\n                flow.set(\n                    backlogClarificationKey,\n                    backlogClarificationExecution\n                );\n            }\n        }\n\n\n        return msg;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"backlog_item\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/backlog/\"\n            + encodeURIComponent(\n                String(backlogItemId)\n            ),\n\n        purpose:\n            \"Obter os dados completos da User Story ou Enabler para avaliacao de qualidade.\"\n    });\n}\n\n\n// ==========================================================\n// 22. Discovery Overview\n// ==========================================================\n\nelse if (capability === \"discovery_overview\") {\n\n    if (!productId) {\n\n        node.error(\n            \"discovery_overview exige product_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"discovery_overview\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/products/\"\n            + encodeURIComponent(productId)\n            + \"/discovery\",\n\n        purpose:\n            \"Obter visao geral do Discovery.\"\n    });\n}\n\n\n// ==========================================================\n// 23. Discovery Opportunity Analysis\n// ==========================================================\n\nelse if (\n    capability ===\n    \"discovery_opportunity_analysis\"\n) {\n\n    if (!opportunityId) {\n\n        node.error(\n            \"discovery_opportunity_analysis exige opportunity_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"opportunity_detail\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/discovery/opportunities/\"\n            + encodeURIComponent(opportunityId),\n\n        purpose:\n            \"Obter dados da oportunidade de Discovery.\"\n    });\n}\n\n\n// ==========================================================\n// 24. Research\n// ==========================================================\n\nelse if (\n    capability === \"research_summary\" ||\n    capability === \"research_insights\" ||\n    capability === \"research_themes\" ||\n    capability === \"research_pains\" ||\n    capability === \"research_needs\" ||\n    capability === \"research_opportunities\" ||\n    capability === \"research_divergences\" ||\n    capability === \"research_compare_stakeholders\" ||\n    capability === \"research_evidence_analysis\"\n) {\n\n    if (!researchId) {\n\n        node.error(\n            capability\n            + \" exige research_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"research_detail\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/discovery/research/\"\n            + encodeURIComponent(researchId),\n\n        purpose:\n            \"Obter dados do Research.\"\n    });\n\n\n    apiPlan.push({\n\n        id:\n            \"research_answers\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/discovery/research/\"\n            + encodeURIComponent(researchId)\n            + \"/answers\",\n\n        purpose:\n            \"Obter perguntas e respostas do Research.\"\n    });\n}\n\n\n// ==========================================================\n// 25. Value Canvas\n// ==========================================================\n\nelse if (\n    capability ===\n    \"value_canvas_analysis\"\n) {\n\n    if (!canvasId) {\n\n        node.error(\n            \"value_canvas_analysis exige canvas_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"value_canvas\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/value-canvas/\"\n            + encodeURIComponent(canvasId),\n\n        purpose:\n            \"Obter dados do Value Canvas.\"\n    });\n}\n\n\n// ==========================================================\n// 26. Process Mapping\n// ==========================================================\n\nelse if (\n    capability ===\n    \"process_mapping_analysis\"\n) {\n\n    if (!processId) {\n\n        node.error(\n            \"process_mapping_analysis exige process_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"process_mapping\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/process-mapping/\"\n            + encodeURIComponent(processId),\n\n        purpose:\n            \"Obter dados do Process Mapping.\"\n    });\n}\n\n\n// ==========================================================\n// 27. Prioritization\n// ==========================================================\n\nelse if (\n    capability ===\n    \"prioritization_analysis\"\n) {\n\n    if (!productId) {\n\n        node.error(\n            \"prioritization_analysis exige product_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"prioritization\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/products/\"\n            + encodeURIComponent(productId)\n            + \"/prioritization\",\n\n        purpose:\n            \"Obter dados de priorizacao.\"\n    });\n}\n\n\n// ==========================================================\n// 28. Sprint\n// ==========================================================\n\nelse if (\n    capability ===\n    \"sprint_analysis\"\n) {\n\n    if (!sprintId) {\n\n        node.error(\n            \"sprint_analysis exige sprint_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"sprint_detail\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/sprints/\"\n            + encodeURIComponent(sprintId),\n\n        purpose:\n            \"Obter dados da Sprint.\"\n    });\n}\n\n\n// ==========================================================\n// 29. Stakeholders\n// ==========================================================\n\nelse if (\n    capability ===\n    \"stakeholders_analysis\"\n) {\n\n    // ------------------------------------------------------\n    // Stakeholder especifico\n    // ------------------------------------------------------\n\n    if (stakeholderId) {\n\n        apiPlan.push({\n\n            id:\n                \"stakeholder_detail\",\n\n            method:\n                \"GET\",\n\n            url:\n                API_BASE_URL\n                + \"/api/v1/flows/stakeholders/\"\n                + encodeURIComponent(stakeholderId),\n\n            purpose:\n                \"Obter dados do stakeholder.\"\n        });\n\n    }\n\n    // ------------------------------------------------------\n    // Stakeholders do produto\n    // ------------------------------------------------------\n\n    else if (productId) {\n\n        apiPlan.push({\n\n            id:\n                \"stakeholders\",\n\n            method:\n                \"GET\",\n\n            url:\n                API_BASE_URL\n                + \"/api/v1/flows/products/\"\n                + encodeURIComponent(productId)\n                + \"/stakeholders\",\n\n            purpose:\n                \"Obter stakeholders cadastrados no produto.\"\n        });\n\n\n        apiPlan.push({\n\n            id:\n                \"stakeholders_summary\",\n\n            method:\n                \"GET\",\n\n            url:\n                API_BASE_URL\n                + \"/api/v1/flows/products/\"\n                + encodeURIComponent(productId)\n                + \"/stakeholders-summary\",\n\n            purpose:\n                \"Obter resumo dos stakeholders do produto.\"\n        });\n\n    }\n    else {\n\n        node.error(\n            \"stakeholders_analysis exige stakeholder_id ou product_id.\",\n            msg\n        );\n\n        return null;\n    }\n}\n\n\n// ==========================================================\n// 30. Meetings\n// ==========================================================\n\nelse if (\n    capability ===\n    \"meetings_analysis\"\n) {\n\n    // ------------------------------------------------------\n    // Meeting especifica\n    // ------------------------------------------------------\n\n    if (meetingId) {\n\n        apiPlan.push({\n\n            id:\n                \"meeting_detail\",\n\n            method:\n                \"GET\",\n\n            url:\n                API_BASE_URL\n                + \"/api/v1/flows/meetings/\"\n                + encodeURIComponent(meetingId),\n\n            purpose:\n                \"Obter dados da meeting.\"\n        });\n\n    }\n\n    // ------------------------------------------------------\n    // Meetings do produto\n    // ------------------------------------------------------\n\n    else if (productId) {\n\n        apiPlan.push({\n\n            id:\n                \"meetings\",\n\n            method:\n                \"GET\",\n\n            url:\n                API_BASE_URL\n                + \"/api/v1/flows/products/\"\n                + encodeURIComponent(productId)\n                + \"/meetings?limit=\"\n                + encodeURIComponent(requestedLimit),\n\n            purpose:\n                \"Obter meetings do produto.\"\n        });\n\n    }\n    else {\n\n        node.error(\n            \"meetings_analysis exige meeting_id ou product_id.\",\n            msg\n        );\n\n        return null;\n    }\n}\n\n\n// ==========================================================\n// 31. Transcript\n// ==========================================================\n\nelse if (\n    capability ===\n    \"transcript_analysis\"\n) {\n\n    if (!transcriptId) {\n\n        node.error(\n            \"transcript_analysis exige transcript_id.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    apiPlan.push({\n\n        id:\n            \"transcript\",\n\n        method:\n            \"GET\",\n\n        url:\n            API_BASE_URL\n            + \"/api/v1/flows/transcripts/\"\n            + encodeURIComponent(transcriptId),\n\n        purpose:\n            \"Obter transcricao da meeting.\"\n    });\n}\n\n\n// ==========================================================\n// 32. Garantir que o plano possui chamadas\n// ==========================================================\n\nif (apiPlan.length === 0) {\n\n    node.error(\n        \"Nenhuma chamada de API foi definida para a capability \"\n        + capability\n        + \".\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 33. Inicializar controle do plano\n// ==========================================================\n\nmsg.apiPlan =\n    apiPlan;\n\n\nmsg.apiPlanIndex =\n    0;\n\n\nmsg.apiResults =\n    {};\n\n\nmsg.apiPlanComplete =\n    false;\n\n\nmsg.skipApi =\n    false;\n\n\n// ==========================================================\n// 34. ACOMPANHAMENTO DA EXECUCAO\n// ==========================================================\n//\n// Neste ponto:\n//\n// - o Planner ja terminou;\n// - a capability ja foi validada;\n// - o apiPlan ja foi montado.\n//\n// Portanto:\n//\n// Plano definido        = completed\n// Consultando dados     = running\n//\n// api_total recebe a quantidade real de chamadas previstas.\n// api_completed comeca em zero.\n//\n// ==========================================================\n\nif (msg.requestId) {\n\n    var executionKey =\n        msg.executionKey ||\n        (\n            \"agent_execution_\"\n            + msg.requestId\n        );\n\n\n    var execution =\n        flow.get(\n            executionKey\n        );\n\n\n    if (execution) {\n\n        execution.status =\n            \"running\";\n\n        execution.stage =\n            \"fetching_data\";\n\n        execution.message =\n            \"Consultando dados\";\n\n        execution.updated_at =\n            Date.now();\n\n\n        if (!execution.steps) {\n\n            execution.steps =\n                {};\n        }\n\n\n        // --------------------------------------------------\n        // Plano concluido\n        // --------------------------------------------------\n\n        execution.steps.plan = {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Plano definido\"\n        };\n\n\n        // --------------------------------------------------\n        // Consulta iniciada\n        // --------------------------------------------------\n\n        execution.steps.data = {\n\n            status:\n                \"running\",\n\n            message:\n                \"Consultando dados\"\n        };\n\n\n        // --------------------------------------------------\n        // Demais etapas continuam pendentes\n        // --------------------------------------------------\n\n        if (!execution.steps.analysis) {\n\n            execution.steps.analysis = {\n\n                status:\n                    \"pending\",\n\n                message:\n                    \"Analisando informacoes\"\n            };\n        }\n\n\n        if (!execution.steps.response) {\n\n            execution.steps.response = {\n\n                status:\n                    \"pending\",\n\n                message:\n                    \"Gerando resposta\"\n            };\n        }\n\n\n        // --------------------------------------------------\n        // Progresso das APIs\n        // --------------------------------------------------\n\n        execution.api_total =\n            apiPlan.length;\n\n        execution.api_completed =\n            0;\n\n\n        // --------------------------------------------------\n        // Persistir\n        // --------------------------------------------------\n\n        flow.set(\n            executionKey,\n            execution\n        );\n    }\n}\n\n\n// ----------------------------------------------------------\n// Status visual no editor aXet\n// ----------------------------------------------------------\n\nnode.status({\n\n    fill:\n        \"blue\",\n\n    shape:\n        \"dot\",\n\n    text:\n        \"Agent: consultando dados\"\n});\n\n\n// ==========================================================\n// 35. Preparar primeira chamada\n// ==========================================================\n\nmsg.currentApiCall =\n    apiPlan[0];\n\n\nmsg.method =\n    msg.currentApiCall.method || \"GET\";\n\n\nmsg.url =\n    msg.currentApiCall.url;\n\n\n// ==========================================================\n// 36. Limpar dados HTTP anteriores\n// ==========================================================\n\ndelete msg.statusCode;\n\ndelete msg.responseUrl;\n\ndelete msg.responseCookies;\n\ndelete msg.responseHeaders;\n\ndelete msg.redirectList;\n\ndelete msg.retry;\n\n\n// ==========================================================\n// 37. Retornar\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":560,"y":300,"wires":[["fd8b10a3e3ee7d53","c515c18641b8ec23"]]},{"id":"6af0736c090d090f","type":"http request","z":"d7713c7a9ce13213","name":"HTTP Request - Product Lab","method":"use","ret":"obj","paytoqs":"ignore","url":"","tls":"","persist":false,"proxy":"","insecureHTTPParser":false,"authType":"","senderr":false,"headers":[],"x":600,"y":640,"wires":[["e2f1a9cb903db74a"]]},{"id":"b92f95cd8002aa5a","type":"enabler-llm","z":"d7713c7a9ce13213","name":"LLM - Gerar Plano","model":"gpt-5-mini","slug":"ntt","projectid":"bcd0c7e7-5be6-49e5-a0f3-bf1a947b26da","x":400,"y":300,"wires":[["1a02e74b7630cc78"]]},{"id":"6c463f8d6c921cd7","type":"function","z":"d7713c7a9ce13213","name":"Function - Prompt","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Prompt\n//\n// Responsabilidades:\n// - receber pergunta e contexto do Product Lab;\n// - normalizar o contexto;\n// - inicializar acompanhamento da execucao;\n// - registrar a ultima execucao para o formulario aXet;\n// - montar prompt do Planner;\n// - definir contrato JSON esperado;\n// - ensinar capabilities disponiveis.\n//\n// IMPORTANTE:\n// O Planner interpreta a intencao.\n// O Planner NAO responde a pergunta.\n// O Planner NAO inventa dados.\n// O Planner NAO monta URLs.\n// ==========================================================\n\n\n// ==========================================================\n// 1. Recuperar entrada\n// ==========================================================\n\nvar input =\n    msg.payload || {};\n\n\nvar pergunta =\n    input.pergunta ||\n    msg.pergunta ||\n    msg.userQuestion ||\n    \"\";\n\n\nvar contexto =\n    input.contexto ||\n    msg.contexto ||\n    msg.productLabContext ||\n    {};\n\n\n// ==========================================================\n// 2. Validar pergunta\n// ==========================================================\n\nif (\n    !pergunta ||\n    typeof pergunta !== \"string\" ||\n    !pergunta.trim()\n) {\n\n    node.error(\n        \"Pergunta do usuario nao informada.\",\n        msg\n    );\n\n    return null;\n}\n\n\npergunta =\n    pergunta.trim();\n\n\n// ==========================================================\n// 3. Preservar pergunta\n// ==========================================================\n\nmsg.userQuestion =\n    pergunta;\n\n\nmsg.rawProductLabContext =\n    contexto;\n\n\n// ==========================================================\n// 4. Normalizar contexto\n// ==========================================================\n\nvar productLabContext = {};\n\n\nif (\n    contexto &&\n    typeof contexto === \"object\" &&\n    !Array.isArray(contexto)\n) {\n\n    productLabContext =\n        contexto;\n\n}\nelse if (\n    typeof contexto === \"string\"\n) {\n\n    // ------------------------------------------------------\n    // Compatibilidade com contexto legado em texto.\n    // ------------------------------------------------------\n\n    productLabContext = {\n        raw_context:\n            contexto\n    };\n}\n\n\nmsg.productLabContext =\n    productLabContext;\n\n\n// ==========================================================\n// 5. Inicializar acompanhamento da execucao do Agent\n// ==========================================================\n//\n// O Product Lab pode enviar request_id.\n//\n// Se nao enviar, o aXet gera um identificador.\n//\n// O request_id identifica uma unica execucao do Agent.\n//\n// O estado completo da execucao sera armazenado em:\n//\n// agent_execution_<request_id>\n//\n// O formulario do aXet podera localizar a ultima execucao\n// utilizando:\n//\n// ai_agent_last_request_id\n//\n// ==========================================================\n\n\n// ----------------------------------------------------------\n// Recuperar request_id\n// ----------------------------------------------------------\n\nvar requestId =\n    input.request_id ||\n    msg.requestId ||\n    null;\n\n\n// ----------------------------------------------------------\n// Gerar request_id como fallback\n// ----------------------------------------------------------\n\nif (!requestId) {\n\n    requestId =\n        \"req_\"\n        + Date.now().toString(36)\n        + \"_\"\n        + Math.random()\n            .toString(36)\n            .substring(2, 10);\n}\n\n\n// ----------------------------------------------------------\n// Normalizar request_id\n// ----------------------------------------------------------\n\nrequestId =\n    String(requestId).trim();\n\n\n// ----------------------------------------------------------\n// Garantir request_id valido\n// ----------------------------------------------------------\n\nif (!requestId) {\n\n    node.error(\n        \"Nao foi possivel definir request_id para a execucao.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ----------------------------------------------------------\n// Preservar request_id durante todo o Flow\n// ----------------------------------------------------------\n\nmsg.requestId =\n    requestId;\n\n\n// ----------------------------------------------------------\n// Criar chave utilizada no flow context\n// ----------------------------------------------------------\n\nvar executionKey =\n    \"agent_execution_\"\n    + requestId;\n\n\nmsg.executionKey =\n    executionKey;\n\n\n// ----------------------------------------------------------\n// Timestamp inicial\n// ----------------------------------------------------------\n\nvar now =\n    Date.now();\n\n\n// ----------------------------------------------------------\n// Criar estado inicial da execucao\n// ----------------------------------------------------------\n\nvar execution = {\n\n    request_id:\n        requestId,\n\n    status:\n        \"running\",\n\n    stage:\n        \"planning\",\n\n    message:\n        \"Definindo plano\",\n\n    started_at:\n        now,\n\n    updated_at:\n        now,\n\n    completed_at:\n        null,\n\n    api_total:\n        0,\n\n    api_completed:\n        0,\n\n    failure_message:\n        null,\n\n    steps: {\n\n        received: {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Pergunta recebida\"\n        },\n\n        context: {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Contexto identificado\"\n        },\n\n        plan: {\n\n            status:\n                \"running\",\n\n            message:\n                \"Definindo plano\"\n        },\n\n        data: {\n\n            status:\n                \"pending\",\n\n            message:\n                \"Consultando dados\"\n        },\n\n        analysis: {\n\n            status:\n                \"pending\",\n\n            message:\n                \"Analisando informacoes\"\n        },\n\n        response: {\n\n            status:\n                \"pending\",\n\n            message:\n                \"Gerando resposta\"\n        }\n    }\n};\n\n\n// ==========================================================\n// 6. Persistir acompanhamento\n// ==========================================================\n\n\n// ----------------------------------------------------------\n// Estado completo desta execucao\n// ----------------------------------------------------------\n\nflow.set(\n    executionKey,\n    execution\n);\n\n\n// ----------------------------------------------------------\n// NOVO:\n// Registrar qual e a ultima execucao do Agent.\n//\n// O formulario aXet utilizara esta chave para descobrir\n// automaticamente qual execucao deve apresentar.\n// ----------------------------------------------------------\n\nflow.set(\n    \"ai_agent_last_request_id\",\n    requestId\n);\n\n\n// ----------------------------------------------------------\n// Status visual do node no editor aXet\n// ----------------------------------------------------------\n\nnode.status({\n\n    fill:\n        \"blue\",\n\n    shape:\n        \"dot\",\n\n    text:\n        \"Agent: definindo plano\"\n});\n\n\n// ==========================================================\n// 7. Prompt de sistema do Planner\n// ==========================================================\n\nvar systemPrompt = `\nVoce e o Planner do AI Agent do Product Lab.\n\nSua responsabilidade e interpretar a pergunta do usuario\ne decidir qual capability do Product Lab deve ser utilizada.\n\nVoce NAO deve responder a pergunta do usuario.\n\nVoce deve retornar SOMENTE um objeto JSON valido.\nNao utilize markdown.\nNao utilize blocos de codigo.\nNao escreva explicacoes fora do JSON.\n\n==========================================================\nPRINCIPIOS\n==========================================================\n\n1. Utilize o contexto atual do Product Lab sempre que\n   ele ja fornecer os IDs necessarios.\n\n2. Nao solicite novamente uma informacao que ja exista\n   no contexto.\n\n3. Nao invente IDs.\n\n4. Nao invente entidades.\n\n5. Nao invente dados do Product Lab.\n\n6. O contexto estruturado fornecido pelo Product Lab\n   e a fonte preferencial para IDs de navegacao.\n\n7. Se faltar uma informacao indispensavel para executar\n   a consulta, utilize capability \"clarification\".\n\n8. A avaliacao ou analise final NAO e responsabilidade\n   deste Planner. Ela sera feita posteriormente.\n\n==========================================================\nCAPABILITIES DISPONIVEIS\n==========================================================\n\nproduct_summary\n- resumo ou informacoes gerais de um produto.\n\nmodules_overview\n- visao geral dos modulos do produto.\n\nrequirements_list\n- consultar requisitos.\n\nrisks_analysis\n- consultar ou analisar riscos.\n\nbacklog_analysis\n- consultar ou analisar o backlog de forma geral.\n\nbacklog_item_quality_review\n- avaliar a qualidade, conformidade ou escrita de uma\n  User Story ou Enabler especifico.\n- utilizar quando o usuario pedir para avaliar, revisar,\n  validar, melhorar ou verificar a qualidade de um item\n  especifico do backlog.\n- utilizar tambem quando o usuario perguntar se o item\n  deveria ser User Story ou Enabler.\n- utilizar quando o usuario pedir avaliacao dos criterios\n  de aceite de um item especifico.\n- esta capability exige backlog_item_id.\n\ndiscovery_overview\n- visao geral do Discovery.\n\ndiscovery_opportunity_analysis\n- analisar uma oportunidade especifica do Discovery.\n\nresearch_summary\n- resumo de Research.\n\nresearch_insights\n- identificar insights de Research.\n\nresearch_themes\n- identificar temas de Research.\n\nresearch_pains\n- identificar pains.\n\nresearch_needs\n- identificar necessidades.\n\nresearch_opportunities\n- identificar oportunidades.\n\nresearch_divergences\n- identificar divergencias.\n\nresearch_compare_stakeholders\n- comparar stakeholders em Research.\n\nresearch_evidence_analysis\n- analisar evidencias de Research.\n\nvalue_canvas_analysis\n- analisar Value Canvas.\n\nprocess_mapping_analysis\n- analisar Process Mapping.\n\nprioritization_analysis\n- analisar priorizacao.\n\nsprint_analysis\n- analisar Sprint.\n\nstakeholders_analysis\n- consultar ou analisar stakeholders.\n\nmeetings_analysis\n- consultar ou analisar meetings.\n\ntranscript_analysis\n- analisar transcricao.\n\nclarification\n- utilizar somente quando faltar informacao indispensavel\n  para continuar.\n\n==========================================================\nBACKLOG ITEM QUALITY REVIEW\n==========================================================\n\nEscolha \"backlog_item_quality_review\" para perguntas como:\n\n\"Avalie a User Story 35583\"\n\"Avalie a qualidade da US 35583\"\n\"Essa story esta boa?\"\n\"Essa story esta pronta?\"\n\"Revise este Enabler\"\n\"Esse item deveria ser User Story ou Enabler?\"\n\"Os criterios de aceite desta story estao bons?\"\n\"Verifique se essa US esta de acordo com nosso padrao\"\n\"O que precisa melhorar nessa story?\"\n\nIMPORTANTE:\n\nSe backlog_item_id estiver presente no contexto atual,\nutilize-o.\n\nExemplo:\n\ncontexto:\n{\n  \"module\": \"backlog\",\n  \"backlog_item_id\": 35583\n}\n\npergunta:\n\"Avalie esta story\"\n\nNesse caso:\nbacklog_item_id = 35583\n\nNao solicite o ID novamente.\n\nO Planner NAO deve executar INVEST.\nO Planner NAO deve avaliar criterios de aceite.\nO Planner NAO deve decidir se a Story esta boa.\n\nApenas identifique a capability e o item.\n\n==========================================================\nANALYSIS TYPES\n==========================================================\n\nlookup\nsummary\ndescriptive\ninsight\ncomparison\npattern\nevidence\ndiagnostic\n\nPara backlog_item_quality_review utilize normalmente:\n\ndiagnostic\n\n==========================================================\nCONTRATO DE SAIDA\n==========================================================\n\nRetorne sempre exatamente um objeto JSON com esta estrutura:\n\n{\n  \"intent\": \"product_lab\",\n  \"capability\": \"...\",\n  \"analysis_type\": \"...\",\n\n  \"product_id\": null,\n  \"module\": null,\n\n  \"entity_type\": null,\n  \"entity_id\": null,\n\n  \"resource_type\": null,\n  \"resource_id\": null,\n\n  \"opportunity_id\": null,\n  \"research_id\": null,\n  \"canvas_id\": null,\n  \"process_id\": null,\n  \"sprint_id\": null,\n\n  \"backlog_item_id\": null,\n\n  \"stakeholder_id\": null,\n  \"meeting_id\": null,\n  \"transcript_id\": null,\n\n  \"limit\": 10,\n\n  \"needs_clarification\": false,\n  \"clarification_question\": null\n}\n\n==========================================================\nCLARIFICATION\n==========================================================\n\nUse clarification apenas quando realmente faltar uma\ninformacao indispensavel.\n\nExemplo:\n\nO usuario pede:\n\"Avalie esta story\"\n\ne nao existe backlog_item_id no contexto e nao existe\nidentificador na pergunta.\n\nNesse caso:\n\n{\n  \"intent\": \"product_lab\",\n  \"capability\": \"clarification\",\n  \"analysis_type\": \"lookup\",\n  \"product_id\": null,\n  \"module\": \"backlog\",\n  \"entity_type\": null,\n  \"entity_id\": null,\n  \"resource_type\": null,\n  \"resource_id\": null,\n  \"opportunity_id\": null,\n  \"research_id\": null,\n  \"canvas_id\": null,\n  \"process_id\": null,\n  \"sprint_id\": null,\n  \"backlog_item_id\": null,\n  \"stakeholder_id\": null,\n  \"meeting_id\": null,\n  \"transcript_id\": null,\n  \"limit\": 10,\n  \"needs_clarification\": true,\n  \"clarification_question\":\n    \"Qual User Story ou Enabler voce deseja avaliar?\"\n}\n\n==========================================================\nREGRA FINAL\n==========================================================\n\nRetorne SOMENTE JSON valido.\n`;\n\n\n// ==========================================================\n// 8. Montar mensagem do usuario para Planner\n// ==========================================================\n\nvar plannerInput = {\n\n    product_lab_context:\n        productLabContext,\n\n    question:\n        pergunta\n};\n\n\n// ==========================================================\n// 9. Montar messages\n// ==========================================================\n\nmsg.messages = [\n\n    {\n        role:\n            \"system\",\n\n        content:\n            systemPrompt\n    },\n\n    {\n        role:\n            \"user\",\n\n        content:\n            JSON.stringify(\n                plannerInput,\n                null,\n                2\n            )\n    }\n];\n\n\n// ==========================================================\n// 10. Configuracao LLM\n// ==========================================================\n\nmsg.max_tokens =\n    1600;\n\n\n// ==========================================================\n// 11. Payload para node LLM\n// ==========================================================\n\nmsg.payload = {\n\n    messages:\n        msg.messages,\n\n    max_tokens:\n        msg.max_tokens\n};\n\n\n// ==========================================================\n// 12. Retornar\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":240,"y":300,"wires":[["b92f95cd8002aa5a","f53bf3db047fbb4a","b920bed8cb479af2"]]},{"id":"141be28a37c42382","type":"function","z":"d7713c7a9ce13213","name":"Function - Preparar resposta","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Preparar resposta\n//\n// Responsabilidades:\n// - reunir pergunta original;\n// - reunir contexto;\n// - reunir resultados das APIs;\n// - escolher instrucoes analiticas;\n// - montar prompt final para o LLM;\n// - atualizar acompanhamento da execucao.\n// ==========================================================\n\n\n// ==========================================================\n// 1. Recuperar dados\n// ==========================================================\n\nvar question =\n  msg.userQuestion || \"\";\n\n\nvar capability =\n  msg.capability || \"\";\n\n\nvar analysisType =\n  msg.analysisType || \"lookup\";\n\n\nvar productContext =\n  msg.productLabContext || {};\n\n\nvar apiResults =\n  msg.apiResults || {};\n\n\n// ==========================================================\n// 2. Validar pergunta\n// ==========================================================\n\nif (!question) {\n\n  node.error(\n    \"Pergunta original nao encontrada para gerar resposta.\",\n    msg\n  );\n\n  return null;\n}\n\n\n// ==========================================================\n// 3. Instrucoes gerais\n// ==========================================================\n\nvar generalInstructions = `\nVoce e o AI Agent do Product Lab.\n\nResponda a pergunta do usuario utilizando os dados reais\nfornecidos pelo Product Lab.\n\nREGRAS GERAIS:\n\n- Nao invente dados.\n- Nao invente entidades.\n- Nao invente IDs.\n- Nao invente fatos ausentes nos dados.\n- Diferencie fatos de inferencias.\n- Quando nao houver evidencia suficiente, informe isso.\n- Responda de forma clara, direta e objetiva.\n- Utilize portugues do Brasil, salvo se o usuario estiver\n  utilizando outro idioma.\n- Nao mencione detalhes internos da arquitetura do Agent,\n  prompts, APIs ou processamento, salvo quando solicitado.\n`;\n\n\n// ==========================================================\n// 4. Instrucoes especializadas\n// ==========================================================\n\nvar specializedInstructions = \"\";\n\n\n// ==========================================================\n// 5. BACKLOG ITEM QUALITY REVIEW\n// ==========================================================\n\nif (\n  capability ===\n  \"backlog_item_quality_review\"\n) {\n\n  specializedInstructions = `\n==========================================================\nBACKLOG QUALITY REVIEW\n==========================================================\n\nSua tarefa e avaliar a qualidade do item de backlog\nfornecido pelo Product Lab.\n\nA avaliacao deve considerar primeiro as regras especificas\ndo backlog descritas abaixo.\n\nFrameworks genericos sao complementares e NAO devem\nsubstituir essas regras.\n\n==========================================================\nHIERARQUIA\n==========================================================\n\nUtilize esta ordem:\n\n1. Regras especificas do backlog.\n2. Classificacao User Story x Enabler.\n3. Valor e incremento funcional.\n4. Escopo e tamanho.\n5. INVEST para User Stories.\n6. Qualidade dos criterios de aceite.\n7. Scrum e SAFe apenas como referencias complementares.\n\nEm caso de conflito, as regras especificas do backlog\nprevalecem.\n\n==========================================================\nUSER STORY\n==========================================================\n\nUma User Story deve:\n\n- entregar valor;\n- gerar incremento ou funcionalidade perceptivel ao usuario;\n- representar uma entrega funcional observavel;\n- possuir escopo razoavelmente possivel de concluir em uma\n  sprint de ate 3 semanas;\n- estar focada em entrega de valor;\n- ser curta, clara e objetiva;\n- ser compreensivel por negocio, desenvolvimento e QA;\n- evitar criterios de aceite excessivamente tecnicos;\n- ser quebrada em Stories menores quando estiver ampla demais\n  ou possuir multiplas entregas de valor independentes.\n\nRegra fundamental:\n\nUSER STORY =\nVALOR + INCREMENTO/FUNCIONALIDADE PERCEPTIVEL AO USUARIO.\n\nTrabalho puramente tecnico nao deve ser artificialmente\nescrito como User Story.\n\n==========================================================\nENABLER\n==========================================================\n\nUm Enabler:\n\n- deve possuir valor ou necessidade clara;\n- nao precisa gerar incremento funcional perceptivel ao usuario;\n- pode habilitar trabalho futuro;\n- pode representar Spike;\n- pode representar pesquisa ou investigacao tecnica;\n- pode representar arquitetura;\n- pode representar integracao tecnica;\n- pode representar infraestrutura;\n- pode representar debito tecnico;\n- pode representar outro trabalho habilitador necessario.\n\nRegra fundamental:\n\nENABLER =\nTEM VALOR, MAS NAO PRECISA GERAR INCREMENTO FUNCIONAL\nPERCEPTIVEL AO USUARIO.\n\nNao penalize um Enabler por nao possuir narrativa artificial\nde usuario.\n\n==========================================================\nCLASSIFICACAO\n==========================================================\n\nAvalie se o tipo cadastrado esta coerente com o conteudo.\n\nSe estiver cadastrado como User Story, mas houver somente\ntrabalho tecnico ou habilitador sem incremento funcional\nperceptivel ao usuario:\n\nsinalize possivel classificacao como Enabler.\n\nSe estiver cadastrado como Enabler, mas entregar nova\nfuncionalidade perceptivel ao usuario:\n\nsinalize possivel classificacao como User Story.\n\nNao altere automaticamente a classificacao.\n\n==========================================================\nINVEST\n==========================================================\n\nPara User Stories, utilize INVEST como referencia complementar:\n\nIndependent\nNegotiable\nValuable\nEstimable\nSmall\nTestable\n\nInterprete:\n\nValuable:\na Story deve demonstrar valor e, segundo as regras deste\nbacklog, incremento funcional perceptivel ao usuario.\n\nSmall:\no escopo deve ser compativel com uma sprint de ate 3 semanas.\n\nTestable:\ndeve existir forma clara de verificar o resultado esperado.\n\nNao transforme INVEST em checklist mecanico.\n\nNao aplique INVEST mecanicamente a Enablers.\n\n==========================================================\nESCOPO E SPRINT\n==========================================================\n\nUma User Story deve ser possivel de realizar em uma sprint\nde ate 3 semanas.\n\nPorem:\n\nNAO afirme categoricamente que uma Story cabe ou nao cabe\nem uma sprint somente pelo tamanho do texto.\n\nProcure evidencias como:\n\n- multiplas funcionalidades independentes;\n- multiplos fluxos de valor;\n- muitos comportamentos distintos;\n- escopo excessivamente amplo;\n- dependencias relevantes;\n- criterios de aceite que representam entregas separaveis.\n\nQuando os dados nao permitirem determinar o tamanho com\nseguranca, diga:\n\n\"Nao ha informacao suficiente para confirmar se o item cabe\nem uma sprint de ate 3 semanas.\"\n\n==========================================================\nQUEBRA DE USER STORIES\n==========================================================\n\nRecomende quebra quando houver indicios concretos de que:\n\n- existem multiplas entregas de valor independentes;\n- existem funcionalidades separaveis;\n- o item aparenta ser amplo demais para uma sprint;\n- partes podem entregar valor independentemente.\n\nQuando recomendar quebra:\n\n- explique o motivo;\n- proponha divisao por valor/funcionalidade;\n- nao decomponha artificialmente em tarefas tecnicas.\n\nCada nova Story sugerida deve continuar entregando valor e\nincremento funcional perceptivel.\n\n==========================================================\nCRITERIOS DE ACEITE\n==========================================================\n\nAvalie se os criterios de aceite sao:\n\n- claros;\n- objetivos;\n- verificaveis;\n- compreensiveis por negocio;\n- compreensiveis por desenvolvimento;\n- compreensiveis por QA;\n- sem ambiguidades relevantes;\n- orientados ao comportamento ou resultado esperado;\n- coerentes com a Story;\n- sem detalhamento tecnico desnecessario.\n\nEvite considerar bons criterios centrados apenas em:\n\n- tabelas;\n- queries;\n- classes;\n- metodos;\n- endpoints;\n- frameworks;\n- procedures;\n- implementacao interna;\n\nquando esses detalhes nao representam comportamento ou\nresultado observavel necessario.\n\nNao exija Gherkin.\n\nDado / Quando / Entao pode ser utilizado quando ajudar,\nmas nao e obrigatorio.\n\n==========================================================\nEVIDENCIA\n==========================================================\n\nNao invente problemas apenas para preencher dimensoes.\n\nNao invente dependencias.\n\nNao invente estimativas.\n\nNao invente criterios de aceite ausentes.\n\nNao conclua algo que os dados nao suportam.\n\nUtilize, quando necessario:\n\n- \"Atende\"\n- \"Atende parcialmente\"\n- \"Precisa de ajuste\"\n- \"Nao foi possivel determinar com as informacoes disponiveis\"\n- \"Nao se aplica\"\n\n==========================================================\nAVALIACAO GERAL\n==========================================================\n\nUtilize preferencialmente uma destas conclusoes:\n\nADEQUADA\n\nADEQUADA COM AJUSTES\n\nPRECISA DE REVISAO\n\nPOSSIVEL CLASSIFICACAO INCORRETA\n\nNao produza porcentagem artificial de qualidade.\n\nNao utilize notas como 82/100 sem que exista metodologia\nformal definida para isso.\n\n==========================================================\nFORMATO DA RESPOSTA\n==========================================================\n\nComece pela conclusao.\n\nFormato preferencial:\n\n1. Avaliacao geral\n2. Classificacao\n3. Pontos positivos\n4. Pontos de atencao\n5. INVEST, somente quando relevante\n6. Criterios de aceite\n7. Recomendacoes\n\nNao crie secoes vazias.\n\nNao repita informacoes.\n\nMostre apenas dimensoes relevantes para o item.\n\n==========================================================\nREESCRITA\n==========================================================\n\nPor padrao:\n\nAVALIE, MAS NAO REESCREVA AUTOMATICAMENTE TODO O ITEM.\n\nSe o usuario pedir explicitamente:\n\n- reescreva;\n- corrija;\n- melhore;\n- gere uma versao revisada;\n- ajuste a Story;\n- ajuste o Enabler;\n\nentao forneca tambem uma versao revisada.\n\nA versao revisada deve preservar a intencao original sempre\nque possivel e corrigir somente os problemas identificados.\n\n==========================================================\nREFERENCIAS COMPLEMENTARES\n==========================================================\n\nScrum, INVEST e SAFe podem ser utilizados como referencias\ncomplementares quando fizer sentido.\n\nNao invente regras organizacionais que nao tenham sido\nfornecidas.\n\nNao trate frameworks genericos como superiores as regras\nespecificas deste backlog.\n`;\n}\n\n\n// ==========================================================\n// 6. Prompt final\n// ==========================================================\n\nvar finalSystemPrompt =\n  generalInstructions\n  + \"\\n\"\n  + specializedInstructions;\n\n\n// ==========================================================\n// 7. Dados fornecidos ao LLM\n// ==========================================================\n\nvar userPayload = {\n\n  question:\n    question,\n\n  capability:\n    capability,\n\n  analysis_type:\n    analysisType,\n\n  product_lab_context:\n    productContext,\n\n  api_results:\n    apiResults\n};\n\n\n// ==========================================================\n// 8. Montar messages\n// ==========================================================\n\nmsg.messages = [\n\n  {\n    role:\n      \"system\",\n\n    content:\n      finalSystemPrompt\n  },\n\n  {\n    role:\n      \"user\",\n\n    content:\n      JSON.stringify(\n        userPayload,\n        null,\n        2\n      )\n  }\n];\n\n\n// ==========================================================\n// 9. Configuracao\n// ==========================================================\n\nmsg.max_tokens =\n  2400;\n\n\n// ==========================================================\n// 10. ACOMPANHAMENTO DA EXECUCAO\n// ==========================================================\n//\n// Neste ponto:\n//\n// - a pergunta ja foi recebida;\n// - o contexto ja foi identificado;\n// - o plano ja foi definido;\n// - os dados necessarios ja foram consultados;\n// - o prompt analitico final ja foi preparado.\n//\n// Portanto:\n//\n// Informacoes analisadas = completed\n// Gerando resposta       = running\n//\n// ==========================================================\n\nif (msg.requestId) {\n\n  var executionKey =\n    msg.executionKey ||\n    (\n      \"agent_execution_\"\n      + msg.requestId\n    );\n\n\n  var execution =\n    flow.get(\n      executionKey\n    );\n\n\n  if (execution) {\n\n    execution.status =\n      \"running\";\n\n\n    execution.stage =\n      \"generating\";\n\n\n    execution.message =\n      \"Gerando resposta\";\n\n\n    execution.updated_at =\n      Date.now();\n\n\n    if (!execution.steps) {\n\n      execution.steps =\n        {};\n    }\n\n\n    // --------------------------------------------------\n    // Analise concluida\n    // --------------------------------------------------\n\n    execution.steps.analysis = {\n\n      status:\n        \"completed\",\n\n      message:\n        \"Informacoes analisadas\"\n    };\n\n\n    // --------------------------------------------------\n    // Geracao da resposta iniciada\n    // --------------------------------------------------\n\n    execution.steps.response = {\n\n      status:\n        \"running\",\n\n      message:\n        \"Gerando resposta\"\n    };\n\n\n    // --------------------------------------------------\n    // Garantir que dados estejam marcados como concluidos\n    //\n    // Isso protege o estado caso o fluxo tenha chegado\n    // aqui por um caminho que consultou a Data API mas\n    // nao tenha atualizado corretamente a etapa anterior.\n    // --------------------------------------------------\n\n    if (\n      execution.steps.data &&\n      execution.steps.data.status === \"running\"\n    ) {\n\n      execution.steps.data.status =\n        \"completed\";\n\n      execution.steps.data.message =\n        \"Dados consultados\";\n    }\n\n\n    // --------------------------------------------------\n    // Persistir\n    // --------------------------------------------------\n\n    flow.set(\n      executionKey,\n      execution\n    );\n  }\n}\n\n\n// ==========================================================\n// 11. Status visual do node no editor aXet\n// ==========================================================\n\nnode.status({\n\n  fill:\n    \"blue\",\n\n  shape:\n    \"dot\",\n\n  text:\n    \"Agent: gerando resposta\"\n});\n\n\n// ==========================================================\n// 12. Payload para LLM\n// ==========================================================\n\nmsg.payload = {\n\n  messages:\n    msg.messages,\n\n  max_tokens:\n    msg.max_tokens\n};\n\n\n// ==========================================================\n// 13. Retornar\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":720,"y":580,"wires":[["fea37d1f57237d21","1ba44d9917bf1a99"]]},{"id":"fea37d1f57237d21","type":"enabler-llm","z":"d7713c7a9ce13213","name":"LLM - Gerar resposta","model":"gpt-4.1-mini","slug":"ntt","projectid":"bcd0c7e7-5be6-49e5-a0f3-bf1a947b26da","x":920,"y":580,"wires":[["6edbe4869c98df99"]]},{"id":"6edbe4869c98df99","type":"function","z":"d7713c7a9ce13213","name":"Function - Extrair resposta","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Extrair resposta\n//\n// Responsabilidades:\n// - extrair a resposta textual produzida pelo LLM;\n// - validar a resposta;\n// - montar payload final;\n// - concluir o acompanhamento da execucao com SUCCESS.\n// ==========================================================\n\n\n// ==========================================================\n// 1. Extrair resposta do LLM\n// ==========================================================\n\nvar resposta = null;\n\n\nif (\n    msg.payload &&\n    msg.payload.choices &&\n    msg.payload.choices[0] &&\n    msg.payload.choices[0].message\n) {\n\n    resposta =\n        msg.payload\n            .choices[0]\n            .message\n            .content;\n}\n\n\n// ==========================================================\n// 2. Validar resposta\n// ==========================================================\n\nif (\n    !resposta ||\n    typeof resposta !== \"string\"\n) {\n\n    node.error(\n        \"LLM nao retornou uma resposta textual valida.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 3. Normalizar resposta\n// ==========================================================\n\nresposta =\n    resposta.trim();\n\n\nif (!resposta) {\n\n    node.error(\n        \"LLM retornou uma resposta vazia.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 4. Atualizar acompanhamento da execucao\n// ==========================================================\n//\n// A resposta da LLM ja foi recebida e validada.\n//\n// Portanto:\n//\n// Resposta gerada = completed\n// Execucao        = success\n//\n// IMPORTANTE:\n// O SUCCESS somente e registrado depois que uma resposta\n// textual valida foi efetivamente obtida.\n// ==========================================================\n\nif (msg.requestId) {\n\n    var executionKey =\n        msg.executionKey ||\n        (\n            \"agent_execution_\"\n            + msg.requestId\n        );\n\n\n    var execution =\n        flow.get(\n            executionKey\n        );\n\n\n    if (execution) {\n\n        var now =\n            Date.now();\n\n\n        execution.status =\n            \"success\";\n\n\n        execution.stage =\n            \"completed\";\n\n\n        execution.message =\n            \"Resposta gerada\";\n\n\n        execution.updated_at =\n            now;\n\n\n        execution.completed_at =\n            now;\n\n\n        execution.failure_message =\n            null;\n\n\n        if (!execution.steps) {\n\n            execution.steps =\n                {};\n        }\n\n\n        // --------------------------------------------------\n        // Garantir etapas anteriores como concluidas\n        // --------------------------------------------------\n\n        if (execution.steps.received) {\n\n            execution.steps.received.status =\n                \"completed\";\n        }\n\n\n        if (execution.steps.context) {\n\n            execution.steps.context.status =\n                \"completed\";\n        }\n\n\n        if (execution.steps.plan) {\n\n            execution.steps.plan.status =\n                \"completed\";\n        }\n\n\n        if (\n            execution.steps.data &&\n            execution.steps.data.status !== \"not_applicable\"\n        ) {\n\n            execution.steps.data.status =\n                \"completed\";\n\n            execution.steps.data.message =\n                \"Dados consultados\";\n        }\n\n\n        if (execution.steps.analysis) {\n\n            execution.steps.analysis.status =\n                \"completed\";\n\n            execution.steps.analysis.message =\n                \"Informacoes analisadas\";\n        }\n\n\n        // --------------------------------------------------\n        // Resposta concluida\n        // --------------------------------------------------\n\n        execution.steps.response = {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Resposta gerada\"\n        };\n\n\n        // --------------------------------------------------\n        // Garantir progresso final das APIs\n        // --------------------------------------------------\n\n        if (\n            execution.api_total &&\n            execution.api_total > 0\n        ) {\n\n            execution.api_completed =\n                execution.api_total;\n        }\n\n\n        // --------------------------------------------------\n        // Persistir estado final\n        // --------------------------------------------------\n\n        flow.set(\n            executionKey,\n            execution\n        );\n    }\n}\n\n\n// ==========================================================\n// 5. Status visual do node no editor aXet\n// ==========================================================\n\nnode.status({\n\n    fill:\n        \"green\",\n\n    shape:\n        \"dot\",\n\n    text:\n        \"Agent: SUCCESS\"\n});\n\n\n// ==========================================================\n// 6. Montar payload final\n// ==========================================================\n\nmsg.payload = {\n\n    resposta:\n        resposta,\n\n    capability:\n        msg.capability,\n\n    analysis_type:\n        msg.analysisType,\n\n    request_id:\n        msg.requestId || null,\n\n    execution_status:\n        \"success\"\n};\n\n\n// ==========================================================\n// 7. Retornar\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":1060,"y":580,"wires":[["682b7d60db2f1dda","3e22386afeb1823a"]]},{"id":"2bbf4ae103fcd7f1","type":"http in","z":"d7713c7a9ce13213","name":"Receber pergunta","url":"/pergunta","method":"post","upload":false,"skipBodyParsing":false,"swaggerDoc":"","securityConfig":"","x":80,"y":300,"wires":[["6c463f8d6c921cd7"]]},{"id":"682b7d60db2f1dda","type":"http response","z":"d7713c7a9ce13213","name":"Enviar resposta","statusCode":"","headers":{},"x":1120,"y":440,"wires":[]},{"id":"29c553bd93e52573","type":"http request","z":"d7713c7a9ce13213","name":"HTTP Request - Login","method":"use","ret":"txt","paytoqs":"ignore","url":"","tls":"","persist":false,"proxy":"","insecureHTTPParser":false,"authType":"","senderr":false,"headers":[],"x":440,"y":780,"wires":[["79620e00d8db79bf"]]},{"id":"79620e00d8db79bf","type":"function","z":"d7713c7a9ce13213","name":"Function - Guardar sessão","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Guardar sessao\n//\n// Responsabilidades:\n// - validar o retorno do login;\n// - localizar o cookie pl_token;\n// - armazenar a sessao;\n// - preservar dados do usuario autenticado;\n// - recuperar a chamada pendente da Data API;\n// - preparar a chamada autenticada para o Product Lab.\n// ==========================================================\n\n\n// ==========================================================\n// 1. Validar status HTTP do login\n// ==========================================================\n\nvar statusCode =\n    Number(msg.statusCode || 0);\n\n\nif (\n    statusCode < 200 ||\n    statusCode >= 300\n) {\n\n    node.error(\n        \"Falha no login do Product Lab. HTTP \"\n        + statusCode,\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 2. Obter payload retornado pelo login\n// ==========================================================\n//\n// Endpoint:\n//\n// POST /api/v1/auth/login\n//\n// Content-Type enviado:\n//\n// application/x-www-form-urlencoded\n//\n// Resposta esperada:\n//\n// {\n//     \"token_type\": \"bearer\",\n//     \"user\": {\n//         ...\n//     }\n// }\n//\n// O JWT da sessao e enviado pelo backend no cookie:\n//\n// pl_token\n//\n// Portanto NAO existe:\n// - access_token\n// - refresh_token\n// - qa_access_token\n// ==========================================================\n\nvar loginPayload =\n    msg.payload;\n\n\n// ==========================================================\n// 3. Converter payload para objeto, se necessario\n// ==========================================================\n\nif (typeof loginPayload === \"string\") {\n\n    try {\n\n        loginPayload =\n            JSON.parse(loginPayload);\n\n    }\n    catch (error) {\n\n        node.error(\n            \"Resposta do login do Product Lab nao e um JSON valido.\",\n            msg\n        );\n\n        return null;\n    }\n}\n\n\n// ==========================================================\n// 4. Validar estrutura da resposta\n// ==========================================================\n\nif (\n    !loginPayload ||\n    typeof loginPayload !== \"object\"\n) {\n\n    node.error(\n        \"Resposta do login do Product Lab esta vazia ou invalida.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 5. Validar token_type\n// ==========================================================\n\nif (\n    !loginPayload.token_type ||\n    String(loginPayload.token_type).toLowerCase() !== \"bearer\"\n) {\n\n    node.error(\n        \"Login do Product Lab nao retornou token_type bearer.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 6. Localizar cookie pl_token\n// ==========================================================\n\nvar plToken = null;\n\n\n// ==========================================================\n// 6.1 Procurar em msg.responseCookies\n// ==========================================================\n\nvar responseCookies =\n    msg.responseCookies || {};\n\n\nif (responseCookies.pl_token) {\n\n    // ------------------------------------------------------\n    // Caso:\n    //\n    // responseCookies.pl_token = \"...\"\n    // ------------------------------------------------------\n\n    if (\n        typeof responseCookies.pl_token === \"string\"\n    ) {\n\n        plToken =\n            responseCookies.pl_token;\n\n    }\n\n    // ------------------------------------------------------\n    // Caso:\n    //\n    // responseCookies.pl_token.value = \"...\"\n    // ------------------------------------------------------\n\n    else if (\n        responseCookies.pl_token.value\n    ) {\n\n        plToken =\n            responseCookies.pl_token.value;\n    }\n}\n\n\n// ==========================================================\n// 6.2 Procurar em msg.headers\n// ==========================================================\n//\n// Algumas implementacoes do HTTP Request disponibilizam\n// Set-Cookie diretamente nos headers.\n// ==========================================================\n\nif (\n    !plToken &&\n    msg.headers\n) {\n\n    var setCookieHeader =\n        msg.headers[\"set-cookie\"]\n        || msg.headers[\"Set-Cookie\"];\n\n\n    if (setCookieHeader) {\n\n        var cookieText = \"\";\n\n\n        if (Array.isArray(setCookieHeader)) {\n\n            cookieText =\n                setCookieHeader.join(\"; \");\n\n        }\n        else {\n\n            cookieText =\n                String(setCookieHeader);\n        }\n\n\n        var cookieMatch =\n            cookieText.match(\n                /(?:^|[;,]\\s*)pl_token=([^;,\\s]+)/\n            );\n\n\n        if (\n            cookieMatch &&\n            cookieMatch[1]\n        ) {\n\n            plToken =\n                cookieMatch[1];\n        }\n    }\n}\n\n\n// ==========================================================\n// 6.3 Procurar em msg.responseHeaders\n// ==========================================================\n//\n// Fallback para implementacoes que armazenam os headers\n// de resposta separadamente.\n// ==========================================================\n\nif (\n    !plToken &&\n    msg.responseHeaders\n) {\n\n    var responseSetCookie =\n        msg.responseHeaders[\"set-cookie\"]\n        || msg.responseHeaders[\"Set-Cookie\"];\n\n\n    if (responseSetCookie) {\n\n        var responseCookieText = \"\";\n\n\n        if (Array.isArray(responseSetCookie)) {\n\n            responseCookieText =\n                responseSetCookie.join(\"; \");\n\n        }\n        else {\n\n            responseCookieText =\n                String(responseSetCookie);\n        }\n\n\n        var responseCookieMatch =\n            responseCookieText.match(\n                /(?:^|[;,]\\s*)pl_token=([^;,\\s]+)/\n            );\n\n\n        if (\n            responseCookieMatch &&\n            responseCookieMatch[1]\n        ) {\n\n            plToken =\n                responseCookieMatch[1];\n        }\n    }\n}\n\n\n// ==========================================================\n// 7. Validar pl_token\n// ==========================================================\n\nif (!plToken) {\n\n    node.error(\n        \"Login do Product Lab realizado, mas o cookie pl_token nao foi encontrado.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 8. Armazenar token da sessao\n// ==========================================================\n//\n// O token fica no contexto do Flow para reutilizacao\n// nas proximas chamadas.\n//\n// NAO armazenamos username/password.\n// ==========================================================\n\nflow.set(\n    \"product_lab_pl_token\",\n    plToken\n);\n\n\n// ==========================================================\n// 9. Armazenar usuario autenticado\n// ==========================================================\n//\n// Informacao opcional que pode ser util posteriormente.\n// ==========================================================\n\nif (\n    loginPayload.user &&\n    typeof loginPayload.user === \"object\"\n) {\n\n    flow.set(\n        \"product_lab_user\",\n        loginPayload.user\n    );\n}\n\n\n// ==========================================================\n// 10. Recuperar chamada pendente\n// ==========================================================\n//\n// Antes de realizar login, o node:\n//\n// Function - Verificar sessao Product Lab\n//\n// deve ter preservado:\n//\n// msg.productLabPendingApiCall\n// ==========================================================\n\nvar pendingApiCall =\n    msg.productLabPendingApiCall;\n\n\nif (\n    !pendingApiCall ||\n    typeof pendingApiCall !== \"object\" ||\n    !pendingApiCall.url\n) {\n\n    node.error(\n        \"Login concluido, mas a chamada pendente da Data API do Product Lab nao foi encontrada.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 11. Restaurar currentApiCall\n// ==========================================================\n\nmsg.currentApiCall =\n    pendingApiCall;\n\n\n// ==========================================================\n// 12. Restaurar metodo HTTP\n// ==========================================================\n\nmsg.method =\n    pendingApiCall.method\n        ? pendingApiCall.method\n        : \"GET\";\n\n\n// ==========================================================\n// 13. Restaurar URL da Data API\n// ==========================================================\n\nmsg.url =\n    pendingApiCall.url;\n\n\n// ==========================================================\n// 14. Preparar headers autenticados\n// ==========================================================\n\nmsg.headers = {\n\n    \"Accept\":\n        \"application/json\",\n\n    \"Cookie\":\n        \"pl_token=\"\n        + plToken\n};\n\n\n// ==========================================================\n// 15. Restaurar payload da chamada, se existir\n// ==========================================================\n//\n// A maioria das chamadas atuais e GET.\n//\n// Para futuras chamadas POST/PATCH/PUT,\n// currentApiCall podera possuir payload.\n// ==========================================================\n\nif (\n    pendingApiCall.payload !== undefined &&\n    pendingApiCall.payload !== null\n) {\n\n    msg.payload =\n        pendingApiCall.payload;\n\n}\nelse {\n\n    delete msg.payload;\n}\n\n\n// ==========================================================\n// 16. Marcar sessao como autenticada\n// ==========================================================\n\nmsg.productLabAuthenticated =\n    true;\n\n\n// ==========================================================\n// 17. Limpar propriedades especificas do login\n// ==========================================================\n//\n// NAO remover:\n// - apiPlan\n// - apiPlanIndex\n// - apiResults\n// - currentApiCall\n// - productLabPendingApiCall\n// - productLabContext\n// - userQuestion\n// - capability\n// - analysisType\n// ==========================================================\n\ndelete msg.statusCode;\n\ndelete msg.responseUrl;\n\ndelete msg.responseCookies;\n\ndelete msg.responseHeaders;\n\ndelete msg.redirectList;\n\ndelete msg.retry;\n\ndelete msg.productLabLoginRequest;\n\n\n// ==========================================================\n// 18. Remover credenciais da mensagem\n// ==========================================================\n//\n// As credenciais nao devem continuar trafegando pelo Flow.\n// ==========================================================\n\ndelete msg.productLabCredentials;\n\n\n// ==========================================================\n// 19. Retornar\n// ==========================================================\n//\n// Proximo destino:\n//\n// HTTP Request - Product Lab\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":580,"y":780,"wires":[["6af0736c090d090f"]]},{"id":"5275963c73494b82","type":"function","z":"d7713c7a9ce13213","name":"Function - Verificar sessão Product Lab","func":"const plToken =\n    flow.get(\n        \"product_lab_pl_token\"\n    );\n\n\nif (plToken) {\n\n    msg.headers = {\n        \"Accept\":\n            \"application/json\",\n\n        \"Cookie\":\n            \"pl_token=\"\n            + plToken\n    };\n\n\n    msg.productLabAuthenticated =\n        true;\n\n\n    return [\n        msg,\n        null\n    ];\n}\n\n\n// ==========================================================\n// Sem sessão\n// ==========================================================\n\nmsg.productLabAuthenticated =\n    false;\n\n\nif (msg.currentApiCall) {\n\n    msg.productLabPendingApiCall = {\n\n        id:\n            msg.currentApiCall.id,\n\n        method:\n            msg.currentApiCall.method || \"GET\",\n\n        url:\n            msg.currentApiCall.url,\n\n        purpose:\n            msg.currentApiCall.purpose || null\n    };\n\n}\nelse {\n\n    msg.productLabPendingApiCall = {\n\n        id:\n            null,\n\n        method:\n            msg.method || \"GET\",\n\n        url:\n            msg.url || null,\n\n        purpose:\n            null\n    };\n}\n\n\nif (!msg.productLabPendingApiCall.url) {\n\n    node.error(\n        \"Não foi possível preservar a chamada \"\n        + \"pendente do Product Lab.\",\n        msg\n    );\n\n    return null;\n}\n\n\nreturn [\n    null,\n    msg\n];","outputs":2,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":220,"y":640,"wires":[["6af0736c090d090f"],["d7ebd66cd042e444"]]},{"id":"838e652473c5fed8","type":"function","z":"d7713c7a9ce13213","name":"Function - Preparar Login","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Preparar Login\n// ==========================================================\n\n\n// ==========================================================\n// 1. Validar credenciais\n// ==========================================================\n\nif (\n    !msg.productLabCredentials ||\n    typeof msg.productLabCredentials !== \"object\"\n) {\n\n    node.error(\n        \"Credenciais do Product Lab nao disponiveis.\",\n        msg\n    );\n\n    return null;\n}\n\n\nvar username =\n    msg.productLabCredentials.username;\n\n\nvar password =\n    msg.productLabCredentials.password;\n\n\nif (!username || !password) {\n\n    node.error(\n        \"Username ou password do Product Lab nao informado.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 2. Validar chamada pendente\n// ==========================================================\n\nif (\n    !msg.productLabPendingApiCall ||\n    !msg.productLabPendingApiCall.url\n) {\n\n    node.error(\n        \"Chamada pendente da Data API do Product Lab nao encontrada.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 3. Validar base URL\n// ==========================================================\n\nif (!msg.productLabApiBaseUrl) {\n\n    node.error(\n        \"productLabApiBaseUrl nao configurado.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 4. Preparar endpoint de login\n// ==========================================================\n\nmsg.method =\n    \"POST\";\n\n\nmsg.url =\n    msg.productLabApiBaseUrl\n    + \"/api/v1/auth/login\";\n\n\n// ==========================================================\n// 5. Preparar headers\n// ==========================================================\n\nmsg.headers = {\n\n    \"Accept\":\n        \"application/json\",\n\n    \"Content-Type\":\n        \"application/x-www-form-urlencoded\"\n};\n\n\n// ==========================================================\n// 6. Preparar body application/x-www-form-urlencoded\n// ==========================================================\n//\n// Contrato:\n//\n// grant_type=password\n// username=<usuario>\n// password=<senha>\n// scope=\n// client_id=\n// client_secret=\n//\n// client_id e client_secret sao opcionais.\n// Enviamos vazios para manter o contrato OAuth2.\n// ==========================================================\n\nvar form = [];\n\n\nform.push(\n    \"grant_type=password\"\n);\n\n\nform.push(\n    \"username=\"\n    + encodeURIComponent(username)\n);\n\n\nform.push(\n    \"password=\"\n    + encodeURIComponent(password)\n);\n\n\nform.push(\n    \"scope=\"\n);\n\n\nform.push(\n    \"client_id=\"\n);\n\n\nform.push(\n    \"client_secret=\"\n);\n\n\nmsg.payload =\n    form.join(\"&\");\n\n\n// ==========================================================\n// 7. Identificar request de login\n// ==========================================================\n\nmsg.productLabLoginRequest =\n    true;\n\n\n// ==========================================================\n// 8. Retornar\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":300,"y":780,"wires":[["29c553bd93e52573"]]},{"id":"6824242ec6330bb8","type":"function","z":"d7713c7a9ce13213","name":"Function - Preparar erro","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Preparar erro\n//\n// Responsabilidades:\n// - preparar resposta controlada para o Product Lab;\n// - registrar internamente o erro tecnico;\n// - finalizar acompanhamento da execucao com FAIL;\n// - identificar a etapa que estava em execucao;\n// - evitar expor detalhes tecnicos ao usuario.\n// ==========================================================\n\n\n// ==========================================================\n// 1. Obter mensagem de erro\n// ==========================================================\n\nvar errorMessage =\n    \"Ocorreu um erro ao processar sua solicitacao.\";\n\n\nif (\n    msg.error &&\n    msg.error.message\n) {\n\n    errorMessage =\n        String(msg.error.message);\n}\n\n\n// ==========================================================\n// 2. Identificar node de origem\n// ==========================================================\n\nvar errorSource =\n    null;\n\n\nif (\n    msg.error &&\n    msg.error.source\n) {\n\n    errorSource = {\n\n        id:\n            msg.error.source.id || null,\n\n        type:\n            msg.error.source.type || null,\n\n        name:\n            msg.error.source.name || null\n    };\n}\n\n\n// ==========================================================\n// 3. Log interno\n// ==========================================================\n//\n// Informacoes tecnicas ficam no aXet Flows.\n//\n// Nao expor para o usuario:\n// - stack trace;\n// - SQL;\n// - tokens;\n// - credenciais;\n// - URLs internas desnecessarias.\n// ==========================================================\n\nnode.warn(\n    \"AI Agent Product Lab - erro capturado: \"\n    + errorMessage\n);\n\n\n// ==========================================================\n// 4. Atualizar acompanhamento da execucao\n// ==========================================================\n//\n// Se existe request_id, localizamos a execucao criada pelo\n// Function - Prompt.\n//\n// A etapa que estiver \"running\" sera marcada como \"failed\".\n//\n// A execucao inteira sera encerrada com:\n//\n// status = fail\n// stage  = failed\n//\n// ==========================================================\n\nvar failedStep =\n    null;\n\n\nif (msg.requestId) {\n\n    var executionKey =\n        msg.executionKey ||\n        (\n            \"agent_execution_\"\n            + msg.requestId\n        );\n\n\n    var execution =\n        flow.get(\n            executionKey\n        );\n\n\n    if (execution) {\n\n        var now =\n            Date.now();\n\n\n        // --------------------------------------------------\n        // Garantir estrutura de steps\n        // --------------------------------------------------\n\n        if (!execution.steps) {\n\n            execution.steps =\n                {};\n        }\n\n\n        // --------------------------------------------------\n        // Ordem conhecida das etapas\n        // --------------------------------------------------\n\n        var stepKeys = [\n\n            \"received\",\n\n            \"context\",\n\n            \"plan\",\n\n            \"data\",\n\n            \"analysis\",\n\n            \"response\"\n        ];\n\n\n        // --------------------------------------------------\n        // Encontrar etapa atualmente em execucao\n        // --------------------------------------------------\n\n        for (\n            var i = 0;\n            i < stepKeys.length;\n            i++\n        ) {\n\n            var stepKey =\n                stepKeys[i];\n\n\n            var step =\n                execution.steps[\n                stepKey\n                ];\n\n\n            if (\n                step &&\n                step.status === \"running\"\n            ) {\n\n                failedStep =\n                    stepKey;\n\n\n                step.status =\n                    \"failed\";\n\n\n                // ------------------------------------------\n                // Mensagem funcional por etapa\n                // ------------------------------------------\n\n                if (stepKey === \"received\") {\n\n                    step.message =\n                        \"Falha ao receber pergunta\";\n                }\n\n                else if (stepKey === \"context\") {\n\n                    step.message =\n                        \"Falha ao identificar contexto\";\n                }\n\n                else if (stepKey === \"plan\") {\n\n                    step.message =\n                        \"Falha ao definir plano\";\n                }\n\n                else if (stepKey === \"data\") {\n\n                    step.message =\n                        \"Falha ao consultar dados\";\n                }\n\n                else if (stepKey === \"analysis\") {\n\n                    step.message =\n                        \"Falha ao analisar informacoes\";\n                }\n\n                else if (stepKey === \"response\") {\n\n                    step.message =\n                        \"Falha ao gerar resposta\";\n                }\n\n\n                break;\n            }\n        }\n\n\n        // --------------------------------------------------\n        // Se nenhuma etapa estava explicitamente running,\n        // tentar identificar pela stage atual\n        // --------------------------------------------------\n\n        if (!failedStep) {\n\n            var currentStage =\n                execution.stage || null;\n\n\n            if (\n                currentStage === \"planning\" &&\n                execution.steps.plan\n            ) {\n\n                failedStep =\n                    \"plan\";\n\n\n                execution.steps.plan.status =\n                    \"failed\";\n\n\n                execution.steps.plan.message =\n                    \"Falha ao definir plano\";\n            }\n\n            else if (\n                currentStage === \"fetching_data\" &&\n                execution.steps.data\n            ) {\n\n                failedStep =\n                    \"data\";\n\n\n                execution.steps.data.status =\n                    \"failed\";\n\n\n                execution.steps.data.message =\n                    \"Falha ao consultar dados\";\n            }\n\n            else if (\n                currentStage === \"analyzing\" &&\n                execution.steps.analysis\n            ) {\n\n                failedStep =\n                    \"analysis\";\n\n\n                execution.steps.analysis.status =\n                    \"failed\";\n\n\n                execution.steps.analysis.message =\n                    \"Falha ao analisar informacoes\";\n            }\n\n            else if (\n                currentStage === \"generating\" &&\n                execution.steps.response\n            ) {\n\n                failedStep =\n                    \"response\";\n\n\n                execution.steps.response.status =\n                    \"failed\";\n\n\n                execution.steps.response.message =\n                    \"Falha ao gerar resposta\";\n            }\n        }\n\n\n        // --------------------------------------------------\n        // Finalizar execucao\n        // --------------------------------------------------\n\n        execution.status =\n            \"fail\";\n\n\n        execution.stage =\n            \"failed\";\n\n\n        execution.message =\n            \"Nao foi possivel concluir a solicitacao\";\n\n\n        execution.updated_at =\n            now;\n\n\n        execution.completed_at =\n            now;\n\n\n        // --------------------------------------------------\n        // Mensagem funcional segura\n        // --------------------------------------------------\n\n        execution.failure_message =\n            \"Nao foi possivel concluir a solicitacao.\";\n\n\n        // --------------------------------------------------\n        // Diagnostico interno\n        //\n        // Este campo fica no flow context.\n        // O endpoint de status NAO deve expor esse detalhe\n        // tecnico diretamente ao usuario.\n        // --------------------------------------------------\n\n        execution.error = {\n\n            message:\n                errorMessage,\n\n            source:\n                errorSource,\n\n            failed_step:\n                failedStep\n        };\n\n\n        // --------------------------------------------------\n        // Persistir estado final\n        // --------------------------------------------------\n\n        flow.set(\n            executionKey,\n            execution\n        );\n    }\n}\n\n\n// ==========================================================\n// 5. Status visual do node no editor aXet\n// ==========================================================\n\nnode.status({\n\n    fill:\n        \"red\",\n\n    shape:\n        \"dot\",\n\n    text:\n        \"Agent: FAIL\"\n});\n\n\n// ==========================================================\n// 6. Definir status HTTP\n// ==========================================================\n//\n// Retornamos 500 para erro interno.\n//\n// O Product Lab deve encerrar o estado de processamento\n// mesmo quando receber resposta nao-2xx.\n// ==========================================================\n\nmsg.statusCode =\n    500;\n\n\n// ==========================================================\n// 7. Preparar resposta segura\n// ==========================================================\n\nmsg.payload = {\n\n    sucesso:\n        false,\n\n    erro:\n        true,\n\n    resposta:\n        \"Não foi possível concluir sua solicitação neste momento. Tente novamente em alguns instantes.\",\n\n    error_code:\n        \"AGENT_PROCESSING_ERROR\",\n\n    request_id:\n        msg.requestId || null,\n\n    execution_status:\n        \"fail\"\n};\n\n\n// ==========================================================\n// 8. Metadados somente para diagnostico interno\n// ==========================================================\n//\n// Estes dados permanecem em msg.agentError para Debug.\n//\n// Eles nao fazem parte de msg.payload e, portanto,\n// nao precisam ser expostos ao Product Lab.\n// ==========================================================\n\nmsg.agentError = {\n\n    message:\n        errorMessage,\n\n    source:\n        errorSource,\n\n    capability:\n        msg.capability || null,\n\n    analysis_type:\n        msg.analysisType || null,\n\n    request_id:\n        msg.requestId || null,\n\n    failed_step:\n        failedStep\n};\n\n\n// ==========================================================\n// 9. Retornar para HTTP Response\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":900,"y":440,"wires":[["682b7d60db2f1dda","4cbc7b836dbaca7e"]]},{"id":"e2f1a9cb903db74a","type":"function","z":"d7713c7a9ce13213","name":"Function - Validar retorno Product Lab","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Validar retorno Product Lab\n//\n// Output 1 = resposta válida\n// Output 2 = autenticar novamente\n// ==========================================================\n\nconst status =\n    Number(msg.statusCode || 0);\n\n\n// ==========================================================\n// 1. Sucesso HTTP\n// ==========================================================\n\nif (\n    status >= 200 &&\n    status < 300\n) {\n\n    msg.productLabRetryCount = 0;\n\n    return [\n        msg,\n        null\n    ];\n}\n\n\n// ==========================================================\n// 2. Não autenticado\n// ==========================================================\n\nif (status === 401) {\n\n    const retryCount =\n        Number(\n            msg.productLabRetryCount || 0\n        );\n\n\n    // Evitar loop infinito de autenticação\n\n    if (retryCount >= 1) {\n\n        node.error(\n            \"Product Lab retornou 401 mesmo após nova autenticação.\",\n            msg\n        );\n\n        return null;\n    }\n\n\n    msg.productLabRetryCount =\n        retryCount + 1;\n\n\n    // Invalidar token armazenado\n\n    flow.set(\n        \"product_lab_pl_token\",\n        null\n    );\n\n\n    // Preservar chamada que precisa ser repetida\n\n    if (msg.currentApiCall) {\n\n        msg.productLabPendingApiCall = {\n            id:\n                msg.currentApiCall.id,\n\n            method:\n                msg.currentApiCall.method || \"GET\",\n\n            url:\n                msg.currentApiCall.url,\n\n            purpose:\n                msg.currentApiCall.purpose || null\n        };\n    }\n\n\n    // Output 2 = login\n\n    return [\n        null,\n        msg\n    ];\n}\n\n\n// ==========================================================\n// 3. Recurso não encontrado\n// ==========================================================\n\nif (status === 404) {\n\n    node.error(\n        \"Recurso não encontrado na Data API do Product Lab. \"\n        + \"Chamada: \"\n        + (\n            msg.currentApiCall\n                ? msg.currentApiCall.id\n                : \"desconhecida\"\n        ),\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 4. Erro de validação\n// ==========================================================\n\nif (status === 422) {\n\n    node.error(\n        \"A Data API do Product Lab rejeitou os parâmetros \"\n        + \"da chamada atual.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 5. Erro do servidor\n// ==========================================================\n\nif (status >= 500) {\n\n    node.error(\n        \"Erro interno na Data API do Product Lab. HTTP \"\n        + status,\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 6. Outros erros\n// ==========================================================\n\nnode.error(\n    \"Erro inesperado na Data API do Product Lab. HTTP \"\n    + status,\n    msg\n);\n\nreturn null;","outputs":2,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":220,"y":500,"wires":[["3a636efb85f69537"],["992587a79b3505f5"]]},{"id":"d7ebd66cd042e444","type":"credentials","z":"d7713c7a9ce13213","name":"Credentials - Product Lab","property":"productLabCredentials","propertyType":"msg","encrypt":false,"x":200,"y":780,"wires":[["838e652473c5fed8"]]},{"id":"3a636efb85f69537","type":"function","z":"d7713c7a9ce13213","name":"Function - Acumular plano API","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Acumular plano API\n//\n// Output 1 = executar proxima chamada\n// Output 2 = plano concluido\n//\n// Responsabilidades adicionais:\n// - registrar progresso das consultas no acompanhamento;\n// - atualizar api_completed / api_total;\n// - marcar Dados consultados quando o plano terminar;\n// - iniciar etapa de analise quando os dados estiverem prontos.\n// ==========================================================\n\n\n// ==========================================================\n// 1. Validar plano\n// ==========================================================\n\nif (\n    !Array.isArray(msg.apiPlan) ||\n    msg.apiPlan.length === 0\n) {\n\n    node.error(\n        \"apiPlan nao disponivel ou vazio.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 2. Validar chamada atual\n// ==========================================================\n\nif (\n    !msg.currentApiCall ||\n    !msg.currentApiCall.id\n) {\n\n    node.error(\n        \"currentApiCall nao disponivel.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 3. Inicializar resultados\n// ==========================================================\n\nif (\n    !msg.apiResults ||\n    typeof msg.apiResults !== \"object\" ||\n    Array.isArray(msg.apiResults)\n) {\n\n    msg.apiResults = {};\n}\n\n\n// ==========================================================\n// 4. Guardar resultado da chamada atual\n// ==========================================================\n\nmsg.apiResults[\n    msg.currentApiCall.id\n] = {\n\n    purpose:\n        msg.currentApiCall.purpose || null,\n\n    statusCode:\n        msg.statusCode || 200,\n\n    data:\n        msg.payload\n};\n\n\n// ==========================================================\n// 5. Descobrir posicao atual e proxima posicao\n// ==========================================================\n\nvar currentIndex =\n    Number(msg.apiPlanIndex);\n\n\nif (\n    !Number.isInteger(currentIndex) ||\n    currentIndex < 0\n) {\n\n    currentIndex = 0;\n}\n\n\nvar nextIndex =\n    currentIndex + 1;\n\n\n// ==========================================================\n// 6. Calcular progresso das APIs\n// ==========================================================\n//\n// currentIndex e baseado em zero.\n//\n// Se estamos processando:\n// apiPlan[0]\n//\n// significa que, ao chegar neste Function,\n// a primeira chamada acabou de ser concluida.\n//\n// Portanto:\n//\n// api_completed = currentIndex + 1\n//\n// ==========================================================\n\nvar apiTotal =\n    msg.apiPlan.length;\n\n\nvar apiCompleted =\n    currentIndex + 1;\n\n\nif (apiCompleted > apiTotal) {\n\n    apiCompleted =\n        apiTotal;\n}\n\n\n// ==========================================================\n// 7. Atualizar acompanhamento da execucao\n// ==========================================================\n\nvar executionKey = null;\n\nvar execution = null;\n\n\nif (msg.requestId) {\n\n    executionKey =\n        msg.executionKey ||\n        (\n            \"agent_execution_\"\n            + msg.requestId\n        );\n\n\n    execution =\n        flow.get(\n            executionKey\n        );\n\n\n    if (execution) {\n\n        execution.status =\n            \"running\";\n\n\n        execution.updated_at =\n            Date.now();\n\n\n        execution.api_total =\n            apiTotal;\n\n\n        execution.api_completed =\n            apiCompleted;\n\n\n        if (!execution.steps) {\n\n            execution.steps =\n                {};\n        }\n    }\n}\n\n\n// ==========================================================\n// 8. Ainda existe outra chamada?\n// ==========================================================\n\nif (nextIndex < msg.apiPlan.length) {\n\n    // ------------------------------------------------------\n    // Atualizar acompanhamento\n    // ------------------------------------------------------\n    //\n    // Ainda existem chamadas pendentes.\n    //\n    // Exemplo:\n    //\n    // Consultando dados... (1 de 2)\n    // ------------------------------------------------------\n\n    if (execution) {\n\n        execution.stage =\n            \"fetching_data\";\n\n\n        execution.message =\n            \"Consultando dados\";\n\n\n        execution.steps.data = {\n\n            status:\n                \"running\",\n\n            message:\n                \"Consultando dados\"\n        };\n\n\n        flow.set(\n            executionKey,\n            execution\n        );\n    }\n\n\n    // ------------------------------------------------------\n    // Status visual do node no editor aXet\n    // ------------------------------------------------------\n\n    node.status({\n\n        fill:\n            \"blue\",\n\n        shape:\n            \"dot\",\n\n        text:\n            \"Agent: dados \"\n            + apiCompleted\n            + \"/\"\n            + apiTotal\n    });\n\n\n    // ------------------------------------------------------\n    // Preparar proxima chamada\n    // ------------------------------------------------------\n\n    var nextCall =\n        msg.apiPlan[nextIndex];\n\n\n    msg.apiPlanIndex =\n        nextIndex;\n\n\n    msg.currentApiCall =\n        nextCall;\n\n\n    msg.method =\n        nextCall.method || \"GET\";\n\n\n    msg.url =\n        nextCall.url;\n\n\n    // ------------------------------------------------------\n    // Limpar dados da resposta anterior\n    // ------------------------------------------------------\n\n    delete msg.payload;\n\n    delete msg.statusCode;\n\n    delete msg.responseUrl;\n\n    delete msg.responseCookies;\n\n    delete msg.responseHeaders;\n\n    delete msg.redirectList;\n\n    delete msg.retry;\n\n\n    msg.apiPlanComplete =\n        false;\n\n\n    // ======================================================\n    // Output 1 = proxima chamada\n    // ======================================================\n\n    return [\n        msg,\n        null\n    ];\n}\n\n\n// ==========================================================\n// 9. Plano concluido\n// ==========================================================\n\nmsg.apiPlanComplete =\n    true;\n\n\n// ==========================================================\n// 10. Atualizar acompanhamento - Dados concluidos\n// ==========================================================\n//\n// Todas as chamadas previstas foram concluidas.\n//\n// Portanto:\n//\n// Dados consultados       = completed\n// Informacoes analisadas  = running\n//\n// A proxima etapa real do fluxo sera preparar a resposta.\n// ==========================================================\n\nif (execution) {\n\n    execution.status =\n        \"running\";\n\n\n    execution.stage =\n        \"analyzing\";\n\n\n    execution.message =\n        \"Analisando informacoes\";\n\n\n    execution.updated_at =\n        Date.now();\n\n\n    execution.api_total =\n        apiTotal;\n\n\n    execution.api_completed =\n        apiTotal;\n\n\n    execution.steps.data = {\n\n        status:\n            \"completed\",\n\n        message:\n            \"Dados consultados\"\n    };\n\n\n    execution.steps.analysis = {\n\n        status:\n            \"running\",\n\n        message:\n            \"Analisando informacoes\"\n    };\n\n\n    if (!execution.steps.response) {\n\n        execution.steps.response = {\n\n            status:\n                \"pending\",\n\n            message:\n                \"Gerando resposta\"\n        };\n    }\n\n\n    flow.set(\n        executionKey,\n        execution\n    );\n}\n\n\n// ==========================================================\n// 11. Status visual do node no editor aXet\n// ==========================================================\n\nnode.status({\n\n    fill:\n        \"blue\",\n\n    shape:\n        \"dot\",\n\n    text:\n        \"Agent: analisando informacoes\"\n});\n\n\n// ==========================================================\n// 12. Preparar payload consolidado\n// ==========================================================\n//\n// Nao precisamos mais que msg.payload represente\n// a ultima chamada HTTP.\n//\n// A partir daqui o conjunto oficial e msg.apiResults.\n// ==========================================================\n\nmsg.payload = {\n\n    capability:\n        msg.capability,\n\n    analysis_type:\n        msg.analysisType,\n\n    context:\n        msg.productLabContext || {},\n\n    results:\n        msg.apiResults\n};\n\n\n// ==========================================================\n// 13. Output 2 = preparar resposta\n// ==========================================================\n\nreturn [\n    null,\n    msg\n];","outputs":2,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":440,"y":400,"wires":[["debdd978d9cd62a9","c992769fbb731eeb"],["141be28a37c42382","c992769fbb731eeb"]]},{"id":"436df977e3523496","type":"link in","z":"d7713c7a9ce13213","name":"link in 1","links":["81d1a6638a4f4fd1","debdd978d9cd62a9"],"x":80,"y":640,"wires":[["5275963c73494b82"]]},{"id":"81d1a6638a4f4fd1","type":"link out","z":"d7713c7a9ce13213","name":"link out 1","mode":"link","links":["436df977e3523496"],"x":800,"y":260,"wires":[]},{"id":"71206657c3321440","type":"link in","z":"d7713c7a9ce13213","name":"link in 2","links":["992587a79b3505f5"],"x":80,"y":780,"wires":[["d7ebd66cd042e444"]]},{"id":"992587a79b3505f5","type":"link out","z":"d7713c7a9ce13213","name":"link out 2","mode":"link","links":["71206657c3321440"],"x":400,"y":500,"wires":[]},{"id":"debdd978d9cd62a9","type":"link out","z":"d7713c7a9ce13213","name":"link out 3","mode":"link","links":["436df977e3523496"],"x":640,"y":400,"wires":[]},{"id":"7102aaa9426f079f","type":"axetflows-app","z":"d7713c7a9ce13213","name":"Product Lab","menu":[{"text":"Menu","icon":"fa fa-sitemap","data":{},"children":[{"id":"j1_5","text":"Ia agent","icon":"fa fa-desktop","data":{"form_id":"0d5e458650698cef","form_name":"Ia agent"},"children":[],"type":"form"}],"type":"root"}],"welcomePage":"0d5e458650698cef","sidebarMenuOrientation":"left","logoImage":"default","schemeColor":"","customCSS":"/* Include your custom CSS styles */","customCSSErrors":0,"authConfig":"Okta","sessionExpireTimeInMinutes":"","basicInternalDb":"","oktaDb":"d40a0ac12599fff5","roles":[],"__wellKnownRes":{},"x":160,"y":40,"wires":[]},{"id":"fd8b10a3e3ee7d53","type":"switch","z":"d7713c7a9ce13213","name":"Switch - Rotear plano","property":"skipApi","propertyType":"msg","rules":[{"t":"eq","v":"false","vt":"jsonata"},{"t":"eq","v":"true","vt":"jsonata"}],"checkall":"true","repair":false,"outputs":2,"x":680,"y":300,"wires":[["81d1a6638a4f4fd1"],["52ce79aca757ec9a"]]},{"id":"52ce79aca757ec9a","type":"function","z":"d7713c7a9ce13213","name":"Function - Responder sem API","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Responder sem API\n//\n// Responsabilidades:\n// - gerar respostas que nao exigem consulta a Data API;\n// - tratar clarification;\n// - atualizar acompanhamento da execucao;\n// - finalizar a execucao com SUCCESS.\n// ==========================================================\n\nvar resposta = null;\n\n\n// ==========================================================\n// 1. Clarification\n// ==========================================================\n\nif (\n    msg.capability === \"clarification\"\n) {\n\n    resposta =\n        msg.clarificationQuestion ||\n        \"Preciso de mais informacoes para realizar esta consulta.\";\n}\n\n\n// ==========================================================\n// 2. Validar resposta\n// ==========================================================\n\nif (\n    !resposta ||\n    typeof resposta !== \"string\"\n) {\n\n    node.error(\n        \"Nao foi possivel gerar resposta sem consulta a API.\",\n        msg\n    );\n\n    return null;\n}\n\n\nresposta =\n    resposta.trim();\n\n\nif (!resposta) {\n\n    node.error(\n        \"Resposta sem consulta a API ficou vazia.\",\n        msg\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 3. Atualizar acompanhamento da execucao\n// ==========================================================\n//\n// Este caminho nao utiliza Data API nem LLM final.\n//\n// Portanto:\n//\n// Pergunta recebida       = completed\n// Contexto identificado   = completed\n// Plano definido          = completed\n// Dados consultados       = not_applicable\n// Informacoes analisadas  = completed\n// Resposta gerada         = completed\n// Execucao                = success\n//\n// ==========================================================\n\nif (msg.requestId) {\n\n    var executionKey =\n        msg.executionKey ||\n        (\n            \"agent_execution_\"\n            + msg.requestId\n        );\n\n\n    var execution =\n        flow.get(\n            executionKey\n        );\n\n\n    if (execution) {\n\n        var now =\n            Date.now();\n\n\n        // --------------------------------------------------\n        // Garantir estrutura\n        // --------------------------------------------------\n\n        if (!execution.steps) {\n\n            execution.steps =\n                {};\n        }\n\n\n        // --------------------------------------------------\n        // Pergunta recebida\n        // --------------------------------------------------\n\n        execution.steps.received = {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Pergunta recebida\"\n        };\n\n\n        // --------------------------------------------------\n        // Contexto identificado\n        // --------------------------------------------------\n\n        execution.steps.context = {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Contexto identificado\"\n        };\n\n\n        // --------------------------------------------------\n        // Plano definido\n        // --------------------------------------------------\n\n        execution.steps.plan = {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Plano definido\"\n        };\n\n\n        // --------------------------------------------------\n        // Data API nao utilizada\n        // --------------------------------------------------\n\n        execution.steps.data = {\n\n            status:\n                \"not_applicable\",\n\n            message:\n                \"Consulta de dados nao necessaria\"\n        };\n\n\n        // --------------------------------------------------\n        // Analise concluida\n        // --------------------------------------------------\n\n        execution.steps.analysis = {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Informacoes analisadas\"\n        };\n\n\n        // --------------------------------------------------\n        // Resposta concluida\n        // --------------------------------------------------\n\n        execution.steps.response = {\n\n            status:\n                \"completed\",\n\n            message:\n                \"Resposta gerada\"\n        };\n\n\n        // --------------------------------------------------\n        // Finalizar execucao\n        // --------------------------------------------------\n\n        execution.status =\n            \"success\";\n\n\n        execution.stage =\n            \"completed\";\n\n\n        execution.message =\n            \"Resposta gerada\";\n\n\n        execution.updated_at =\n            now;\n\n\n        execution.completed_at =\n            now;\n\n\n        execution.failure_message =\n            null;\n\n\n        execution.api_total =\n            0;\n\n\n        execution.api_completed =\n            0;\n\n\n        // --------------------------------------------------\n        // Limpar eventual erro anterior\n        // --------------------------------------------------\n\n        execution.error =\n            null;\n\n\n        // --------------------------------------------------\n        // Persistir\n        // --------------------------------------------------\n\n        flow.set(\n            executionKey,\n            execution\n        );\n    }\n}\n\n\n// ==========================================================\n// 4. Status visual do node no editor aXet\n// ==========================================================\n\nnode.status({\n\n    fill:\n        \"green\",\n\n    shape:\n        \"dot\",\n\n    text:\n        \"Agent: SUCCESS\"\n});\n\n\n// ==========================================================\n// 5. Contrato de resposta para o Product Lab\n// ==========================================================\n\nmsg.payload = {\n\n    resposta:\n        resposta,\n\n    capability:\n        msg.capability,\n\n    analysis_type:\n        msg.analysisType || null,\n\n    request_id:\n        msg.requestId || null,\n\n    execution_status:\n        \"success\"\n};\n\n\n// ==========================================================\n// 6. Retornar\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":880,"y":300,"wires":[["682b7d60db2f1dda","0d10e88ace6ceacc"]]},{"id":"de26d04ed14d4a99","type":"catch","z":"d7713c7a9ce13213","name":"","scope":null,"uncaught":false,"x":740,"y":440,"wires":[["6824242ec6330bb8"]]},{"id":"f53bf3db047fbb4a","type":"use-case","z":"d7713c7a9ce13213","name":"","userid":"00u9pwqz04nGEhp2v417","projectid":"bcd0c7e7-5be6-49e5-a0f3-bf1a947b26da","useCaseCategory":"CAAGS","usecaseid":"UC-0490-FLOW-001","isAI":"","x":420,"y":220,"wires":[]},{"id":"0d5e458650698cef","type":"axetflows-form","z":"d7713c7a9ce13213","name":"IA Agent","onDocumentReadyButtonAction":"","formStructure":{"components":[{"label":"AI Agent Execution Status","attributes":[{}],"content":"<div class='ai-agent-status'><strong>Status do AI Agent</strong><br>Aguardando execução...</div>","key":"ai_agent_execution_status","tags":[{"tag":""}],"type":"customhtml","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","customClass":"ai-agent-execution-status","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":true,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"data","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"Acompanhamento da execução do AI Agent.","hideLabel":true,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{"purpose":"ai_agent_execution_status"},"allowMultipleMasks":false,"tag":"","id":"eawuncl"}]},"associatedEntityMetamodel":null,"associatedEntityFormType":null,"associatedContractModelMetamodel":null,"associatedPersistantFormId":null,"associatedLocalStorageDatabaseId":null,"buttons":[],"outputs":1,"x":320,"y":60,"wires":[[]]},{"id":"2f05b3d75342363f","type":"function","z":"d7713c7a9ce13213","name":"Function - Atualizar Status Form","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Atualizar Status Form\n//\n// Responsabilidades:\n// - localizar a execucao atual do Agent;\n// - montar HTML do andamento;\n// - preparar msg.submission;\n// - enviar o estado ao Rx View Action.\n//\n// Este ramo e somente de UI.\n// Ele NAO deve retornar ao fluxo principal do Agent.\n// ==========================================================\n\n\n// ==========================================================\n// 1. Recuperar request_id\n// ==========================================================\n\nvar requestId =\n    msg.requestId ||\n    (\n        msg.payload &&\n            msg.payload.request_id\n            ? msg.payload.request_id\n            : null\n    ) ||\n    flow.get(\"ai_agent_last_request_id\") ||\n    null;\n\n\nif (!requestId) {\n\n    node.warn(\n        \"Status Form: request_id nao encontrado.\"\n    );\n\n    return null;\n}\n\n\nrequestId =\n    String(requestId).trim();\n\n\n// ==========================================================\n// 2. Recuperar execucao\n// ==========================================================\n\nvar executionKey =\n    msg.executionKey ||\n    (\n        \"agent_execution_\"\n        + requestId\n    );\n\n\nvar execution =\n    flow.get(\n        executionKey\n    );\n\n\nif (!execution) {\n\n    node.warn(\n        \"Status Form: execucao nao encontrada: \"\n        + executionKey\n    );\n\n    return null;\n}\n\n\n// ==========================================================\n// 3. Definicao das etapas\n// ==========================================================\n\nvar definitions = [\n\n    {\n        key:\n            \"received\",\n\n        label:\n            \"Pergunta recebida\"\n    },\n\n    {\n        key:\n            \"context\",\n\n        label:\n            \"Contexto identificado\"\n    },\n\n    {\n        key:\n            \"plan\",\n\n        label:\n            \"Plano definido\"\n    },\n\n    {\n        key:\n            \"data\",\n\n        label:\n            \"Dados consultados\"\n    },\n\n    {\n        key:\n            \"analysis\",\n\n        label:\n            \"Informacoes analisadas\"\n    },\n\n    {\n        key:\n            \"response\",\n\n        label:\n            \"Resposta gerada\"\n    }\n];\n\n\n// ==========================================================\n// 4. Simbolos por estado\n// ==========================================================\n\nvar symbols = {\n\n    completed:\n        \"&#10003;\",\n\n    running:\n        \"&#9679;\",\n\n    pending:\n        \"&#9675;\",\n\n    failed:\n        \"&#10005;\"\n};\n\n\n// ==========================================================\n// 5. Montar HTML\n// ==========================================================\n\nvar html =\n    \"<div class='ai-agent-status'>\"\n    + \"<strong>Status do AI Agent</strong>\"\n    + \"<br><br>\";\n\n\n// ==========================================================\n// 6. Percorrer etapas\n// ==========================================================\n\nfor (\n    var i = 0;\n    i < definitions.length;\n    i++\n) {\n\n    var definition =\n        definitions[i];\n\n\n    var step =\n        execution.steps &&\n            execution.steps[definition.key]\n            ? execution.steps[definition.key]\n            : null;\n\n\n    if (!step) {\n\n        continue;\n    }\n\n\n    // ------------------------------------------------------\n    // Etapas nao aplicaveis nao sao exibidas\n    // ------------------------------------------------------\n\n    if (\n        step.status ===\n        \"not_applicable\"\n    ) {\n\n        continue;\n    }\n\n\n    var symbol =\n        symbols[step.status] ||\n        \"&#9675;\";\n\n\n    var text =\n        step.message ||\n        definition.label;\n\n\n    // ------------------------------------------------------\n    // Mostrar progresso das chamadas da Data API\n    // ------------------------------------------------------\n\n    if (\n        definition.key === \"data\" &&\n        step.status === \"running\" &&\n        Number(execution.api_total) > 0\n    ) {\n\n        text +=\n            \" (\"\n            + Number(\n                execution.api_completed || 0\n            )\n            + \" de \"\n            + Number(\n                execution.api_total || 0\n            )\n            + \")\";\n    }\n\n\n    // ------------------------------------------------------\n    // Linha\n    // ------------------------------------------------------\n\n    html +=\n        \"<div>\"\n        + symbol\n        + \" \"\n        + text;\n\n\n    if (\n        step.status ===\n        \"running\"\n    ) {\n\n        html +=\n            \"...\";\n    }\n\n\n    html +=\n        \"</div>\";\n}\n\n\n// ==========================================================\n// 7. Resultado final\n// ==========================================================\n\nif (\n    execution.status === \"success\"\n) {\n\n    html +=\n        \"<br>\"\n        + \"<div>\"\n        + \"<strong>\"\n        + \"&#10003; SUCCESS\"\n        + \"</strong>\"\n        + \"</div>\";\n}\n\nelse if (\n    execution.status === \"fail\"\n) {\n\n    html +=\n        \"<br>\"\n        + \"<div>\"\n        + \"<strong>\"\n        + \"&#10005; FAIL\"\n        + \"</strong>\"\n        + \"</div>\";\n}\n\n\nhtml +=\n    \"</div>\";\n\n\n// ==========================================================\n// 8. Preparar submission para Rx View Action\n// ==========================================================\n//\n// O rx-view-action utiliza msg.submission para atualizar\n// reativamente o formulario.\n//\n// A estrutura do customhtml foi validada como:\n//\n// msg.submission\n//    .ai_agent_execution_status\n//    .content\n//\n// ==========================================================\n\nmsg.submission = {\n\n    ai_agent_execution_status: {\n\n        content:\n            html\n    }\n};\n\n\n// ==========================================================\n// 9. Metadados auxiliares\n// ==========================================================\n\nmsg.statusRequestId =\n    requestId;\n\n\nmsg.statusExecution =\n    execution.status;\n\n\nmsg.statusStage =\n    execution.stage;\n\n\n// ==========================================================\n// 10. Status visual do Function\n// ==========================================================\n\nif (\n    execution.status === \"success\"\n) {\n\n    node.status({\n\n        fill:\n            \"green\",\n\n        shape:\n            \"dot\",\n\n        text:\n            \"UI: SUCCESS\"\n    });\n}\n\nelse if (\n    execution.status === \"fail\"\n) {\n\n    node.status({\n\n        fill:\n            \"red\",\n\n        shape:\n            \"dot\",\n\n        text:\n            \"UI: FAIL\"\n    });\n}\n\nelse {\n\n    node.status({\n\n        fill:\n            \"blue\",\n\n        shape:\n            \"dot\",\n\n        text:\n            \"UI: \"\n            + (\n                execution.message ||\n                execution.stage ||\n                \"running\"\n            )\n    });\n}\n\n\n// ==========================================================\n// 11. Retornar SOMENTE para o ramo Rx\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":480,"y":980,"wires":[["f9caeb0e288fbe97"]]},{"id":"f9caeb0e288fbe97","type":"axetflows-rx-view-action","z":"d7713c7a9ce13213","name":"Rx View Action - Status Agent","action":"update","page":"0d5e458650698cef","message":"","messageType":"info","x":620,"y":980,"wires":[]},{"id":"b920bed8cb479af2","type":"link out","z":"d7713c7a9ce13213","name":"link out 4","mode":"link","links":["0519e01f87f84360"],"x":320,"y":220,"wires":[]},{"id":"0519e01f87f84360","type":"link in","z":"d7713c7a9ce13213","name":"link in 3","links":["b920bed8cb479af2","c515c18641b8ec23","c992769fbb731eeb","1ba44d9917bf1a99","3e22386afeb1823a","4cbc7b836dbaca7e","0d10e88ace6ceacc"],"x":337.04864,"y":980,"wires":[["2f05b3d75342363f"]]},{"id":"c515c18641b8ec23","type":"link out","z":"d7713c7a9ce13213","name":"link out 5","mode":"link","links":["0519e01f87f84360"],"x":620,"y":240,"wires":[]},{"id":"c992769fbb731eeb","type":"link out","z":"d7713c7a9ce13213","name":"link out 6","mode":"link","links":["0519e01f87f84360"],"x":660,"y":480,"wires":[]},{"id":"1ba44d9917bf1a99","type":"link out","z":"d7713c7a9ce13213","name":"link out 7","mode":"link","links":["0519e01f87f84360"],"x":820,"y":640,"wires":[]},{"id":"3e22386afeb1823a","type":"link out","z":"d7713c7a9ce13213","name":"link out 8","mode":"link","links":["0519e01f87f84360","b42e85b4bc202ce1"],"x":1160,"y":660,"wires":[]},{"id":"4cbc7b836dbaca7e","type":"link out","z":"d7713c7a9ce13213","name":"link out 9","mode":"link","links":["0519e01f87f84360","b42e85b4bc202ce1"],"x":980,"y":400,"wires":[]},{"id":"0d10e88ace6ceacc","type":"link out","z":"d7713c7a9ce13213","name":"link out 10","mode":"link","links":["0519e01f87f84360","b42e85b4bc202ce1"],"x":1000,"y":280,"wires":[]},{"id":"b31b33c9f2861337","type":"delay","z":"d7713c7a9ce13213","name":"Delay - Resetar Status Agent","pauseType":"delay","timeout":"30","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"allowrate":false,"outputs":1,"x":360,"y":1120,"wires":[["8155558132e03be8"]]},{"id":"8155558132e03be8","type":"function","z":"d7713c7a9ce13213","name":"Function - Resetar Status Form","func":"// ==========================================================\n// PRODUCT LAB - AI AGENT\n// Function - Resetar Status Form\n// ==========================================================\n\n\n// ==========================================================\n// 1. Preparar estado inicial do formulario\n// ==========================================================\n\nmsg.submission = {\n\n    ai_agent_execution_status: {\n\n        content:\n            \"<div class='ai-agent-status'>\"\n            + \"<strong>Status do AI Agent</strong>\"\n            + \"<br>\"\n            + \"Aguardando execução...\"\n            + \"</div>\"\n    }\n};\n\n\n// ==========================================================\n// 2. Status visual do node\n// ==========================================================\n\nnode.status({\n\n    fill:\n        \"grey\",\n\n    shape:\n        \"ring\",\n\n    text:\n        \"UI: aguardando execucao\"\n});\n\n\n// ==========================================================\n// 3. Retornar para Rx View Action\n// ==========================================================\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// O código adicionado aqui será executado uma vez\n// sempre que o nó for iniciado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n\n// Você pode usar module.exports para usar o mecanismo de exportação\n// e reutilizar objetos e funções exportados em outro nó de função.\n// Exemplo: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// O código adicionado aqui será executado\n// quando o nó for parado ou reimplantado.\n\n// Você pode usar require(..) para instalar dependências NPM dinamicamente.\n// Exemplo: const lowerCase = require('lower-case@1.1.3')\n\n// Você pode usar importModule(..) para instalar dependências ESM NPM dinamicamente.\n// Exemplo: const chalkNs = await importModule('chalk')\n","x":560,"y":1120,"wires":[["f9caeb0e288fbe97"]]},{"id":"b42e85b4bc202ce1","type":"link in","z":"d7713c7a9ce13213","name":"link in 4","links":["3e22386afeb1823a","4cbc7b836dbaca7e","0d10e88ace6ceacc"],"x":200,"y":1120,"wires":[["b31b33c9f2861337"]]},{"id":"654ed2361e0c05dc","type":"axetflows-form","z":"305ef6944cb235df","name":"User Okta Search Form","onDocumentReadyButtonAction":null,"formStructure":{"display":"form","settings":{},"components":[{"label":"User Okta","tag":"div","attrs":[{"attr":"","value":""}],"content":"<h1>User Okta</h1>","refreshOnChange":false,"tableView":false,"key":"UserOKTA","type":"htmlelement","input":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"attributes":{},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"