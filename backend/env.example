# ─────────────────────────────────────────────────────────────────────────────
# Product Lab — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais.
# ATENÇÃO: .env nunca deve ser commitado no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de Dados PostgreSQL ─────────────────────────────────────────────────
# Desenvolvimento local (sem Docker):
DATABASE_URL=postgresql://productlab:prdctmngr2026@localhost:5432/product_lab

# Com Docker Compose (o compose já injeta esta variável — não é necessário aqui):
# DATABASE_URL=postgresql://productlab:prdctmngr2026@db:5432/product_lab

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# OBRIGATÓRIO — sem este valor o app recusa subir.
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-de-64-chars

# ── CORS — origens permitidas (separadas por vírgula) ─────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://seu-dominio.com

# ── Pool de Conexões ──────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── OpenAI (opcional — necessário para geração de conteúdo no módulo Communication) ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
